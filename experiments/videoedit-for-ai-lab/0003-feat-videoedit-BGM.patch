+"""字幕のテスト。ffmpeg は起動しない。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import subtitle
+from videoedit.core import VideoEditError
+
+SAMPLE = """1
+00:00:00,500 --> 00:00:02,500
+最初の字幕です
+
+2
+00:00:03,000 --> 00:00:05,000
+2行に
+またがる字幕
+"""
+
+
+def test_parse_reads_every_cue():
+    cues = subtitle.parse_srt(SAMPLE)
+    assert len(cues) == 2
+    assert cues[0].start == pytest.approx(0.5)
+    assert cues[0].end == pytest.approx(2.5)
+    assert cues[1].text == "2行に\nまたがる字幕"
+
+
+def test_parse_accepts_crlf_and_a_byte_order_mark():
+    raw = "﻿" + SAMPLE.replace("\n", "\r\n")
+    assert len(subtitle.parse_srt(raw)) == 2
+
+
+def test_parse_accepts_a_dot_before_the_milliseconds():
+    raw = "1\n00:00:01.000 --> 00:00:02.000\nほんぶん\n"
+    assert subtitle.parse_srt(raw)[0].end == pytest.approx(2.0)
+
+
+def test_parse_accepts_cues_without_a_number():
+    raw = "00:00:01,000 --> 00:00:02,000\nほんぶん\n"
+    assert len(subtitle.parse_srt(raw)) == 1
+
+
+def test_an_empty_file_is_refused():
+    with pytest.raises(VideoEditError, match="1つもありません"):
+        subtitle.parse_srt("   \n\n  ")
+
+
+def test_a_cue_without_a_timecode_names_its_position():
+    raw = "1\n00:00:01,000 --> 00:00:02,000\nよい\n\n2\nこわれている\n"
+    with pytest.raises(VideoEditError, match="2 個目"):
+        subtitle.parse_srt(raw)
+
+
+def test_a_cue_without_a_body_is_refused():
+    raw = "1\n00:00:01,000 --> 00:00:02,000\n"
+    with pytest.raises(VideoEditError, match="本文がありません"):
+        subtitle.parse_srt(raw)
+
+
+def test_an_end_before_the_start_is_refused():
+    raw = "1\n00:00:05,000 --> 00:00:02,000\nほんぶん\n"
+    with pytest.raises(VideoEditError, match="より後になっていません"):
+        subtitle.parse_srt(raw)
+
+
+def test_cues_past_the_end_of_the_video_are_reported():
+    cues = subtitle.parse_srt(SAMPLE)
+    notes = subtitle.check_against(cues, duration=1.0)
+    assert notes and "表示されません" in notes[0]
+
+
+def test_a_cue_running_past_the_end_is_reported():
+    cues = subtitle.parse_srt(SAMPLE)
+    notes = subtitle.check_against(cues, duration=4.0)
+    assert notes and "途中で切れます" in notes[0]
+
+
+def test_nothing_to_report_when_the_cues_fit():
+    assert subtitle.check_against(subtitle.parse_srt(SAMPLE), duration=10.0) == []
+
+
+# --- フィルタとコマンド -------------------------------------------------
+
+
+def test_burn_filter_escapes_the_path():
+    assert subtitle.burn_filter("/tmp/a:b/s.srt").startswith(r"subtitles='/tmp/a\:b/s.srt'")
+
+
+def test_burn_filter_takes_a_font_family_name_not_a_path():
+    result = subtitle.burn_filter("s.srt", font_name="Meiryo", size=28)
+    # libass は書体名で探す。パスは fontsdir で別に教える。
+    assert "FontName=Meiryo" in result
+    assert "FontSize=28" in result
+
+
+def test_a_font_file_becomes_a_fonts_directory():
+    assert subtitle.fonts_dir_for("/a/b/meiryo.ttc").endswith("/a/b")
+    assert subtitle.fonts_dir_for(None) is None
+
+
+def test_a_zero_subtitle_size_is_refused():
+    with pytest.raises(VideoEditError, match="0 以下"):
+        subtitle.force_style(size=0)
+
+
+def test_no_style_is_no_force_style():
+    assert subtitle.force_style() is None
+    assert "force_style" not in subtitle.burn_filter("s.srt")
+
+
+def test_soft_command_copies_everything_and_tags_the_language():
+    command = subtitle.soft_command("in.mp4", "s.srt", "o.mp4")
+    assert command[command.index("-c") + 1] == "copy"
+    assert command[command.index("-c:s") + 1] == subtitle.SOFT_CODEC
+    assert "language=jpn" in command
