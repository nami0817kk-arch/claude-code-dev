+"""BGM・ダッキング・音量正規化のテスト。ffmpeg は起動しない。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import audio
+from videoedit.core import VideoEditError
+
+SETTINGS = audio.BgmSettings(path="bgm.wav")
+
+
+def value_after(command, flag):
+    return command[command.index(flag) + 1]
+
+
+# --- BGM ---------------------------------------------------------------
+
+
+def test_bgm_is_cut_to_the_length_of_the_video():
+    # -stream_loop で繰り返させたうえで、ここで尺を確定させる
+    assert "atrim=duration=90.000000" in audio.bgm_chain(SETTINGS, duration=90)
+
+
+def test_bgm_fades_out_so_it_ends_with_the_video():
+    chain = audio.bgm_chain(audio.BgmSettings(path="b.wav", fade_out=2), duration=90)
+    assert "afade=t=out:st=88.000000:d=2" in chain
+
+
+def test_a_fade_longer_than_the_video_starts_at_the_beginning():
+    chain = audio.bgm_chain(audio.BgmSettings(path="b.wav", fade_out=200), duration=90)
+    assert "afade=t=out:st=0.000000:d=200" in chain
+
+
+def test_fades_can_be_turned_off():
+    chain = audio.bgm_chain(audio.BgmSettings(path="b.wav", fade_in=0, fade_out=0), duration=90)
+    assert "afade" not in chain
+
+
+def test_a_negative_fade_is_rejected():
+    with pytest.raises(VideoEditError, match="fade_in が負"):
+        audio.BgmSettings(path="b.wav", fade_in=-1)
+
+
+def test_mixing_does_not_halve_the_volume():
+    # amix は既定で入力数で割る。混ぜただけで音量が下がるのは意図しない。
+    assert "normalize=0" in audio.mix_filter(SETTINGS, duration=10, has_voice=True)
+
+
+def test_without_voice_the_bgm_becomes_the_whole_track():
+    graph = audio.mix_filter(SETTINGS, duration=10, has_voice=False)
+    assert "amix" not in graph
+    assert graph.endswith("[bgm]anull[aout]")
+
+
+def test_ducking_splits_the_voice_to_drive_the_compressor():
+    graph = audio.mix_filter(
+        audio.BgmSettings(path="b.wav", duck=True), duration=10, has_voice=True
+    )
+    # 元の音声は、混ぜる用と引き金用の2つに分ける
+    assert "[0:a]asplit=2[voice][key]" in graph
+    assert "[bgm][key]sidechaincompress=" in graph
+
+
+def test_ducking_without_voice_is_refused():
+    settings = audio.BgmSettings(path="b.wav", duck=True)
+    with pytest.raises(VideoEditError, match="下げる相手がいません"):
+        audio.mix_filter(settings, duration=10, has_voice=False)
+
+
+def test_bgm_command_copies_the_video():
+    command = audio.bgm_command("in.mp4", "o.mp4", SETTINGS, duration=10, has_voice=True)
+    # 映像は触らないので、BGM を差し替えるたびに再エンコードしない
+    assert "-c:v" in command and value_after(command, "-c:v") == "copy"
+    assert value_after(command, "-stream_loop") == "-1"
+
+
+# --- loudnorm ----------------------------------------------------------
+
+
+def test_loudnorm_uses_an_equals_for_the_first_separator():
+    # loudnorm:I=... と書くと ffmpeg がフィルタ名を解釈できない
+    assert audio.loudnorm_filter().startswith("loudnorm=I=")
+
+
+def test_the_second_pass_carries_the_measured_values():
+    measured = {
+        "input_i": "-21.9",
+        "input_tp": "-3.0",
+        "input_lra": "5.0",
+        "input_thresh": "-32.0",
+        "target_offset": "0.5",
+    }
+    result = audio.loudnorm_filter(measured)
+    assert "measured_I=-21.9" in result
+    assert "offset=0.5" in result
+    assert "linear=true" in result
+
+
+def test_incomplete_measurements_are_refused():
+    with pytest.raises(VideoEditError, match="測定値が足りません"):
+        audio.loudnorm_filter({"input_i": "-21.9"})
+
+
+def test_the_measuring_pass_writes_nothing_and_skips_the_video():
+    command = audio.normalize_measure_command("in.mp4")
+    assert command[-3:] == ["-f", "null", "-"]
+    # 映像を復号しないので、実尺よりずっと速く終わる
+    assert "-vn" in command
+    assert "print_format=json" in " ".join(command)
+
+
+def test_measurements_are_read_from_the_json_in_the_log():
+    stderr = (
+        "some ffmpeg log line\n"
+        "[Parsed_loudnorm_0 @ 0x1] \n"
+        '{\n"input_i" : "-21.89",\n"input_tp" : "-3.01",\n"input_lra" : "5.20",\n'
+        '"input_thresh" : "-32.02",\n"output_i" : "-14.0",\n"target_offset" : "0.13"\n}\n'
+    )
+    measured = audio.parse_measured(stderr)
+    assert measured["input_i"] == "-21.89"
+    assert measured["target_offset"] == "0.13"
+
+
+def test_a_log_without_json_says_so():
+    with pytest.raises(VideoEditError, match="測定値を読み取れません"):
+        audio.parse_measured("ffmpeg ran but printed nothing useful")
+
+
+def test_json_missing_a_field_is_refused():
+    with pytest.raises(VideoEditError, match="足りない項目"):
+        audio.parse_measured('{"input_i" : "-21.89"}')
+
+
+def test_normalize_command_copies_the_video():
+    command = audio.normalize_command("in.mp4", "o.mp4")
+    assert value_after(command, "-c:v") == "copy"
+    assert "loudnorm=I=-14" in value_after(command, "-af")
