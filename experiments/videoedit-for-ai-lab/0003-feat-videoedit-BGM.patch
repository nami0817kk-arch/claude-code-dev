index 0000000..f1b607c
--- /dev/null
+++ b/src/videoedit/subtitle.py
@@ -0,0 +1,155 @@
+r"""字幕（SRT）の焼き込みとソフトサブ。
+
+焼き込みは libass の ``subtitles`` フィルタを使う。テロップ(drawtext)と違って
+**フォントはパスではなく書体名（FontName）で指定する**。libass が字幕の中身から
+必要な字形を探すので、パスを渡す仕組みになっていないため。フォントファイルの
+場所は ``fontsdir`` で教える。
+
+- 焼き込み … 映像に描き込む。どの再生環境でも必ず見える。映像の再エンコードが要る。
+- ソフトサブ … 字幕トラックとして入れる。切り替えられるが、対応した再生環境が要る。
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from dataclasses import dataclass
+
+from .core import VideoEditError
+from .overlay import quote
+
+# mp4 に入れられる字幕形式。mkv なら srt のまま入るが、既定は mp4 なので mov_text。
+SOFT_CODEC = "mov_text"
+
+TIMECODE = re.compile(
+    r"(?P<h>\d+):(?P<m>\d{2}):(?P<s>\d{2})[,.](?P<ms>\d{1,3})"
+)
+ARROW = "-->"
+
+
+@dataclass(frozen=True)
+class Cue:
+    """字幕1つ。"""
+
+    index: int
+    start: float
+    end: float
+    text: str
+
+
+def parse_srt(raw: str) -> list[Cue]:
+    """SRT を読む。壊れている箇所は、何行目かを添えて指摘する。
+
+    焼き込みは ffmpeg 任せでも動くが、字幕が1つも出ない・時刻がずれている
+    といった失敗は書き出してからでは気づきにくい。先に読んで確かめる。
+    """
+    text = raw.lstrip("﻿").replace("\r\n", "\n").replace("\r", "\n")
+    cues: list[Cue] = []
+    blocks = [block for block in re.split(r"\n{2,}", text) if block.strip()]
+    for position, block in enumerate(blocks, start=1):
+        lines = [line for line in block.split("\n") if line.strip()]
+        if lines and ARROW not in lines[0]:
+            lines = lines[1:]  # 先頭は通し番号。無くても読める。
+        if not lines:
+            raise VideoEditError(f"字幕の {position} 個目が空です")
+        if ARROW not in lines[0]:
+            raise VideoEditError(
+                f"字幕の {position} 個目に時刻の行がありません: {lines[0][:40]!r}"
+            )
+        start, end = _parse_timecodes(lines[0], position)
+        body = "\n".join(lines[1:]).strip()
+        if not body:
+            raise VideoEditError(f"字幕の {position} 個目に本文がありません")
+        cues.append(Cue(index=position, start=start, end=end, text=body))
+
+    if not cues:
+        raise VideoEditError("字幕が1つもありません")
+    return cues
+
+
+def _parse_timecodes(line: str, position: int) -> tuple[float, float]:
+    found = TIMECODE.findall(line)
+    if len(found) != 2:
+        raise VideoEditError(f"字幕の {position} 個目の時刻を読めません: {line.strip()!r}")
+    start, end = (_to_seconds(match) for match in found)
+    if end <= start:
+        raise VideoEditError(
+            f"字幕の {position} 個目の終わり {end:g}s が始まり {start:g}s より後になっていません"
+        )
+    return start, end
+
+
+def _to_seconds(match: tuple[str, str, str, str]) -> float:
+    hours, minutes, seconds, milliseconds = match
+    return (
+        int(hours) * 3600
+        + int(minutes) * 60
+        + int(seconds)
+        + int(milliseconds.ljust(3, "0")) / 1000
+    )
+
+
+def check_against(cues: list[Cue], duration: float) -> list[str]:
+    """動画の尺と突き合わせて、気になる点を文章で返す（止めはしない）。"""
+    notes: list[str] = []
+    overrun = [cue for cue in cues if cue.start >= duration]
+    if overrun:
+        notes.append(
+            f"{len(overrun)} 個の字幕が動画の尺 {duration:.2f}s より後から始まります"
+            f"（{overrun[0].index} 個目以降）。表示されません"
+        )
+    elif cues[-1].end > duration + 0.5:
+        notes.append(
+            f"最後の字幕の終わり {cues[-1].end:.2f}s が動画の尺 {duration:.2f}s を"
+            "超えています。途中で切れます"
+        )
+    return notes
+
+
+def force_style(font_name: str | None = None, size: int | None = None) -> str | None:
+    """libass に渡す見た目の指定。``FontName`` は**書体名**で、パスではない。"""
+    parts = []
+    if font_name:
+        parts.append(f"FontName={font_name}")
+    if size is not None:
+        if size <= 0:
+            raise VideoEditError(f"字幕の文字サイズが 0 以下です: {size}")
+        parts.append(f"FontSize={size}")
+    return ",".join(parts) if parts else None
+
+
+def burn_filter(
+    path: str, *, font_name: str | None = None, size: int | None = None, fonts_dir: str | None = None
+) -> str:
+    """字幕を映像に描き込むフィルタ。"""
+    parts = [f"subtitles={quote(path)}"]
+    if fonts_dir:
+        parts.append(f"fontsdir={quote(fonts_dir)}")
+    style = force_style(font_name, size)
+    if style:
+        parts.append(f"force_style={quote(style)}")
+    return ":".join(parts)
+
+
+def fonts_dir_for(font_path: str | None) -> str | None:
+    """フォントファイルを渡されたら、その置き場を libass に教える。"""
+    if not font_path:
+        return None
+    return os.path.dirname(os.path.abspath(font_path)) or None
+
+
+def soft_command(
+    source: str, subtitle_path: str, output: str, *, language: str = "jpn", overwrite: bool = True
+) -> list[str]:
+    """字幕トラックとして入れるコマンド。映像も音声もコピーする。"""
+    return [
+        "ffmpeg", "-hide_banner", "-y" if overwrite else "-n",
+        "-i", source,
+        "-i", subtitle_path,
+        "-map", "0",
+        "-map", "1",
+        "-c", "copy",
+        "-c:s", SOFT_CODEC,
+        "-metadata:s:s:0", f"language={language}",
+        output,
+    ]
