+"""BGM のミックス・ダッキング・音量の正規化。
+
+映像には触らないので、この工程は ``-c:v copy`` で回せる。連結やテロップと
+同じ手順に混ぜず、独立した1段にしてあるのはそのため（映像を作り直さずに
+BGM だけ差し替えられる）。
+
+音量の正規化(loudnorm)は**2パス**。1パス目で測り、2パス目で当てる。
+1パス目は ``-vn -f null -`` なので映像を触らず、実尺よりずっと速く終わる。
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+
+from .core import VideoEditError
+
+# YouTube の再生時ラウドネスに合わせた既定値。
+TARGET_LUFS = -14.0
+TARGET_TRUE_PEAK = -1.5
+TARGET_LRA = 11.0
+
+DEFAULT_GAIN_DB = -18.0
+DEFAULT_FADE_IN = 1.0
+DEFAULT_FADE_OUT = 2.0
+
+# ダッキングの既定。しゃべりが入ると BGM が下がり、切れると戻る。
+DUCK_THRESHOLD = 0.05
+DUCK_RATIO = 8
+DUCK_ATTACK_MS = 20
+DUCK_RELEASE_MS = 400
+
+_MEASURED_KEYS = ("input_i", "input_tp", "input_lra", "input_thresh", "target_offset")
+
+
+@dataclass(frozen=True)
+class BgmSettings:
+    """BGM の載せ方。"""
+
+    path: str
+    gain: float = DEFAULT_GAIN_DB
+    duck: bool = False
+    fade_in: float = DEFAULT_FADE_IN
+    fade_out: float = DEFAULT_FADE_OUT
+
+    def __post_init__(self) -> None:
+        for name in ("fade_in", "fade_out"):
+            if getattr(self, name) < 0:
+                raise VideoEditError(f"{name} が負です: {getattr(self, name)}")
+
+
+def bgm_chain(settings: BgmSettings, *, duration: float, label: str = "1:a") -> str:
+    """BGM 側の下ごしらえ。尺に合わせて切り、音量を下げ、頭と尻をなじませる。
+
+    ``-stream_loop -1`` で入力を繰り返させたうえで、ここで尺ぴったりに切る。
+    ``-shortest`` の解釈に頼らず、出来上がりの尺を確定させるため。
+    """
+    if duration <= 0:
+        raise VideoEditError(f"尺が 0 以下です: {duration}")
+    steps = [
+        f"atrim=duration={duration:.6f}",
+        "asetpts=N/SR/TB",
+        f"volume={settings.gain:g}dB",
+    ]
+    if settings.fade_in:
+        steps.append(f"afade=t=in:st=0:d={settings.fade_in:g}")
+    if settings.fade_out:
+        start = max(0.0, duration - settings.fade_out)
+        steps.append(f"afade=t=out:st={start:.6f}:d={settings.fade_out:g}")
+    return f"[{label}]" + ",".join(steps) + "[bgm]"
+
+
+def mix_filter(
+    settings: BgmSettings,
+    *,
+    duration: float,
+    has_voice: bool,
+    loudnorm: str | None = None,
+) -> str:
+    """BGM を載せる filter_complex を組み立てる。出力は ``[aout]``。
+
+    ``has_voice`` は素材が音声を持っているか。持っていなければ BGM だけになる。
+    """
+    if settings.duck and not has_voice:
+        raise VideoEditError(
+            "素材に音声が無いので、ダッキングは効きません（下げる相手がいません）。"
+            "--duck を外してください"
+        )
+
+    steps = [bgm_chain(settings, duration=duration)]
+    if not has_voice:
+        last = "bgm"
+    elif settings.duck:
+        # 元の音声を2つに分け、片方をダッキングの引き金(sidechain)に使う
+        steps.append("[0:a]asplit=2[voice][key]")
+        steps.append(
+            f"[bgm][key]sidechaincompress="
+            f"threshold={DUCK_THRESHOLD}:ratio={DUCK_RATIO}"
+            f":attack={DUCK_ATTACK_MS}:release={DUCK_RELEASE_MS}[ducked]"
+        )
+        # normalize=0 が無いと amix が入力数で割り、混ぜるだけで音量が半分になる
+        steps.append("[voice][ducked]amix=inputs=2:duration=first:normalize=0[mixed]")
+        last = "mixed"
+    else:
+        steps.append("[0:a][bgm]amix=inputs=2:duration=first:normalize=0[mixed]")
+        last = "mixed"
+
+    if loudnorm:
+        steps.append(f"[{last}]{loudnorm}[aout]")
+    else:
+        steps.append(f"[{last}]anull[aout]")
+    return ";".join(steps)
+
+
+def loudnorm_filter(
+    measured: dict[str, str] | None = None,
+    *,
+    target: float = TARGET_LUFS,
+    print_json: bool = False,
+) -> str:
+    """loudnorm フィルタ。``measured`` を渡すと2パス目（当てる側）になる。"""
+    # 最初の区切りは = で、以降は :（loudnorm=I=-14:TP=-1.5 の形）
+    parts = [
+        f"I={target:g}",
+        f"TP={TARGET_TRUE_PEAK:g}",
+        f"LRA={TARGET_LRA:g}",
+    ]
+    if measured:
+        missing = [key for key in _MEASURED_KEYS if key not in measured]
+        if missing:
+            raise VideoEditError(f"1パス目の測定値が足りません: {', '.join(missing)}")
+        parts += [
+            f"measured_I={measured['input_i']}",
+            f"measured_TP={measured['input_tp']}",
+            f"measured_LRA={measured['input_lra']}",
+            f"measured_thresh={measured['input_thresh']}",
+            f"offset={measured['target_offset']}",
+            "linear=true",
+        ]
+    if print_json:
+        parts.append("print_format=json")
+    return "loudnorm=" + ":".join(parts)
+
+
+def _measure_tail() -> list[str]:
+    """1パス目の締め。``-vn`` で映像を復号せず、どこにも書き出さない。"""
+    return ["-vn", "-f", "null", "-"]
+
+
+def parse_measured(stderr: str) -> dict[str, str]:
+    """loudnorm が stderr の末尾に出す JSON を読む。
+
+    ffmpeg は測定値を「ログの中の JSON」として吐く。他のログ行が混ざるので、
+    最後の ``{`` から末尾の ``}`` までを切り出して読む。
+    """
+    match = re.search(r"\{[^{}]*\"input_i\"[^{}]*\}", stderr, re.DOTALL)
+    if not match:
+        raise VideoEditError(
+            "loudnorm の測定値を読み取れませんでした。"
+            "ffmpeg のログに JSON が出ていません"
+        )
+    try:
+        measured = json.loads(match.group(0))
+    except json.JSONDecodeError as exc:
+        raise VideoEditError(f"loudnorm の測定値を JSON として読めませんでした: {exc}") from None
+
+    missing = [key for key in _MEASURED_KEYS if key not in measured]
+    if missing:
+        raise VideoEditError(f"loudnorm の測定値に足りない項目があります: {', '.join(missing)}")
+    return {key: str(measured[key]) for key in _MEASURED_KEYS}
+
+
+# --- コマンドの組み立て -------------------------------------------------
+
+
+def _head(overwrite: bool) -> list[str]:
+    return ["ffmpeg", "-hide_banner", "-y" if overwrite else "-n"]
+
+
+AUDIO_ARGS = ("-c:a", "aac", "-b:a", "192k")
+# 映像は触らないのでコピーする。BGM を差し替えるたびに再エンコードしない。
+VIDEO_COPY = ("-c:v", "copy")
+
+
+def _bgm_inputs(source: str, settings: BgmSettings) -> list[str]:
+    # -stream_loop -1 で入力を繰り返させる。BGM が動画より短くても最後まで鳴る。
+    return ["-i", source, "-stream_loop", "-1", "-i", settings.path]
+
+
+def bgm_command(
+    source: str,
+    output: str,
+    settings: BgmSettings,
+    *,
+    duration: float,
+    has_voice: bool,
+    loudnorm: str | None = None,
+    overwrite: bool = True,
+) -> list[str]:
+    """BGM を載せるコマンド。映像は触らないのでコピーする。"""
+    return [
+        *_head(overwrite),
+        *_bgm_inputs(source, settings),
+        "-filter_complex", mix_filter(
+            settings, duration=duration, has_voice=has_voice, loudnorm=loudnorm
+        ),
+        "-map", "0:v",
+        "-map", "[aout]",
+        *VIDEO_COPY,
+        *AUDIO_ARGS,
+        output,
+    ]
+
+
+def bgm_measure_command(
+    source: str,
+    settings: BgmSettings,
+    *,
+    duration: float,
+    has_voice: bool,
+    target: float = TARGET_LUFS,
+) -> list[str]:
+    """BGM を載せた結果の音量を測るだけのコマンド（loudnorm の1パス目）。"""
+    return [
+        "ffmpeg", "-hide_banner", "-nostats",
+        *_bgm_inputs(source, settings),
+        "-filter_complex", mix_filter(
+            settings,
+            duration=duration,
+            has_voice=has_voice,
+            loudnorm=loudnorm_filter(target=target, print_json=True),
+        ),
+        "-map", "[aout]",
+        *_measure_tail(),
+    ]
+
+
+def normalize_command(
+    source: str,
+    output: str,
+    *,
+    measured: dict[str, str] | None = None,
+    target: float = TARGET_LUFS,
+    overwrite: bool = True,
+) -> list[str]:
+    """音量だけ揃えるコマンド。映像は触らないのでコピーする。"""
+    return [
+        *_head(overwrite),
+        "-i", source,
+        "-af", loudnorm_filter(measured, target=target),
+        "-map", "0:v",
+        "-map", "0:a",
+        *VIDEO_COPY,
+        *AUDIO_ARGS,
+        output,
+    ]
+
+
+def normalize_measure_command(source: str, *, target: float = TARGET_LUFS) -> list[str]:
+    """音量を測るだけのコマンド（loudnorm の1パス目）。"""
+    return [
+        "ffmpeg", "-hide_banner", "-nostats",
+        "-i", source,
+        "-af", loudnorm_filter(target=target, print_json=True),
+        *_measure_tail(),
+    ]
