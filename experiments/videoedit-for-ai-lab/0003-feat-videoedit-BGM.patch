+    plain, ducked = tmp_path / "plain.mp4", tmp_path / "ducked.mp4"
+    common = [clips["a"], bgm, "--gain", "0", "--fade-in", "0", "--fade-out", "0"]
+    assert cli.main(["bgm", *common, "-o", str(plain)]) == 0
+    assert cli.main(["bgm", *common, "-o", str(ducked), "--duck"]) == 0
+    # 素材は最初から最後までしゃべっているので、ダッキングは効きっぱなしになる
+    assert measure_loudness(str(ducked)) < measure_loudness(str(plain)) - 0.5
+
+
+def test_normalize_hits_the_target_loudness(tmp_path, clips):
+    out = tmp_path / "norm.mp4"
+    assert cli.main(["normalize", clips["a"], "-o", str(out)]) == 0
+    # 2パスなので、狙った値にほぼぴったり乗る
+    assert measure_loudness(str(out)) == pytest.approx(-14.0, abs=0.5)
+
+
+def test_normalize_can_aim_somewhere_else(tmp_path, clips):
+    out = tmp_path / "norm23.mp4"
+    assert cli.main(["normalize", clips["a"], "-o", str(out), "--target", "-23"]) == 0
+    assert measure_loudness(str(out)) == pytest.approx(-23.0, abs=0.5)
+
+
+def test_ducking_without_audio_is_refused(tmp_path, clips, bgm, capsys):
+    out = tmp_path / "x.mp4"
+    assert cli.main(["bgm", clips["b"], bgm, "-o", str(out), "--duck"]) == 1
+    assert "下げる相手がいません" in capsys.readouterr().err
+
+
+def test_subtitles_are_burned_into_the_picture(tmp_path, clips, srt):
+    import hashlib
+
+    out = tmp_path / "burned.mp4"
+    assert cli.main(["subtitle", clips["a"], srt, "-o", str(out)]) == 0
+
+    def frame_at(source, at):
+        image = tmp_path / f"s{at}_{os.path.basename(source)}.png"
+        core.run([
+            "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
+            "-ss", str(at), "-i", source, "-frames:v", "1", str(image),
+        ])
+        return hashlib.md5(image.read_bytes()).hexdigest()
+
+    # 字幕が出ている 1s では絵が変わる
+    assert frame_at(str(out), 1.0) != frame_at(clips["a"], 1.0)
+
+
+def test_soft_subtitles_become_a_track(tmp_path, clips, srt):
+    out = tmp_path / "soft.mp4"
+    assert cli.main(["subtitle", clips["a"], srt, "-o", str(out), "--soft"]) == 0
+    payload = core.run_json([
+        "ffprobe", "-v", "error", "-print_format", "json",
+        "-show_streams", "-select_streams", "s", str(out),
+    ])
+    assert [stream["codec_name"] for stream in payload["streams"]] == ["mov_text"]
+
+
+def test_build_runs_the_whole_pipeline(tmp_path, clips, font, bgm, srt):
+    """シーン -> 連結 -> 字幕の焼き込み -> BGM とダッキングと音量揃え。"""
+    script = tmp_path / "script.json"
+    output = tmp_path / "ep.mp4"
+    script.write_text(
+        json.dumps(
+            {
+                "output": str(output),
+                "preset": "youtube-720p",
+                "audio": {"bgm": bgm, "gain": -16, "duck": True, "normalize": True},
+                "subtitle": {"file": srt},
+                "scenes": [
+                    {
+                        "source": clips["a"],
+                        "trim": [0, 3],
+                        "text": [{"value": "オープニング", "at": 0.5, "for": 2, "pos": "top"}],
+                    },
+                    {"source": clips["b"], "transition": "crossfade"},
+                ],
+            }
+        ),
+        encoding="utf-8",
+    )
+    assert cli.main(["build", str(script), "--font", font]) == 0
+    info = probe(str(output))
+    # 3 + 3 から、重なり 0.5s ぶん縮む
+    assert info.duration == pytest.approx(5.5, abs=0.25)
+    assert info.size == (1280, 720)
+    assert measure_loudness(str(output)) == pytest.approx(-14.0, abs=1.0)
