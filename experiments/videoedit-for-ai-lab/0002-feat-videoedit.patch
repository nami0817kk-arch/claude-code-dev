+"""テロップのテスト。ffmpeg は起動しない。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import overlay
+from videoedit.core import VideoEditError
+
+
+def test_quote_escapes_the_option_separator():
+    # 包むだけでは足りない。: は AVOption の区切りとして解釈されてしまう。
+    assert overlay.quote("/tmp/a:b/font.ttf") == r"'/tmp/a\:b/font.ttf'"
+
+
+def test_quote_normalises_windows_separators():
+    # C:\Windows\Fonts をそのまま入れると二重に解釈されて壊れる
+    assert overlay.quote("C:\\Windows\\Fonts\\meiryo.ttc") == r"'C\:/Windows/Fonts/meiryo.ttc'"
+
+
+def test_quote_escapes_single_quotes():
+    assert overlay.quote("it's") == "'it'\\''s'"
+
+
+def test_drawtext_passes_the_body_through_a_file():
+    item = overlay.Overlay(text="ここがポイント", start=3, end=7)
+    result = overlay.drawtext_filter(
+        item, text_path="/w/text_001.txt", font_path="/f/font.ttf", height=1080
+    )
+    # 本文を text= に直接埋めない。エスケープが要るのはパスだけになる。
+    assert "textfile='/w/text_001.txt'" in result
+    assert "ここがポイント" not in result
+
+
+def test_drawtext_limits_the_visible_range():
+    item = overlay.Overlay(text="hi", start=3, end=7)
+    assert "between(t,3,7)" in overlay.drawtext_filter(
+        item, text_path="t.txt", font_path="f.ttf"
+    )
+
+
+def test_a_telop_without_an_end_stays_until_the_scene_ends():
+    item = overlay.Overlay(text="hi", start=2)
+    assert "gte(t,2)" in overlay.drawtext_filter(item, text_path="t.txt", font_path="f.ttf")
+
+
+def test_the_background_band_can_be_turned_off():
+    plain = overlay.Overlay(text="hi", box_color=None)
+    assert "box=1" not in overlay.drawtext_filter(plain, text_path="t.txt", font_path="f.ttf")
+
+
+@pytest.mark.parametrize("position", sorted(overlay.POSITIONS))
+def test_every_position_produces_coordinates(position):
+    item = overlay.Overlay(text="hi", position=position)
+    result = overlay.drawtext_filter(item, text_path="t.txt", font_path="f.ttf", height=1080)
+    assert ":x=" in result and ":y=" in result
+
+
+def test_an_unknown_position_lists_the_available_ones():
+    with pytest.raises(VideoEditError, match="bottom"):
+        overlay.Overlay(text="hi", position="middle-ish")
+
+
+def test_an_empty_body_is_rejected():
+    with pytest.raises(VideoEditError, match="本文が空"):
+        overlay.Overlay(text="   ")
+
+
+def test_an_end_before_the_start_is_rejected():
+    with pytest.raises(VideoEditError, match="より後になっていません"):
+        overlay.Overlay(text="hi", start=5, end=2)
+
+
+@pytest.mark.parametrize(("height", "expected"), [(1080, 54), (720, 36), (1920, 96), (None, 54)])
+def test_font_size_follows_the_output_height(height, expected):
+    assert overlay.font_size_for(height) == expected
+
+
+def test_an_explicit_font_size_wins():
+    assert overlay.font_size_for(1080, 20) == 20
+
+
+def test_a_zero_font_size_is_rejected():
+    with pytest.raises(VideoEditError, match="0 以下"):
+        overlay.font_size_for(1080, 0)
+
+
+def test_find_font_prefers_the_explicit_path(tmp_path):
