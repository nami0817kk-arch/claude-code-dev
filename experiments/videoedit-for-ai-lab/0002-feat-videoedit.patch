+r"""テロップ（drawtext）。
+
+**本文は必ずファイル経由（`textfile=`）で渡す。** `text=` に直接埋めると
+`:` `'` `\` `%` と改行のエスケープで必ず事故る。本文をファイルに逃がせば、
+エスケープが要るのは「ファイルのパス」だけになる。
+
+パスのエスケープは実機で確かめた次の規則に従う（ffmpeg 6.1 / 7.x）。
+
+- filter の引数値を `'...'` で包む。
+- その中で `:` を `\:` と書く。包むだけでは AVOption の区切りとして解釈されてしまう。
+- `\` は `/` に寄せる。Windows のパスをそのまま入れると二重に解釈されて壊れる
+  （`C:/Windows/Fonts/meiryo.ttc` の形なら Windows でもそのまま開ける）。
+
+包まずに `\\:` と書いても通るが、`'...'` で包む形に統一している。
+`,` や `;` を含む式（`enable='between(t,1,5)'`）も同じ包み方で守れるため。
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+from .core import VideoEditError
+
+# 画面の端から本文までの余白（出力解像度に対する比率）。
+MARGIN_RATIO = 0.06
+
+POSITIONS = {
+    "bottom": "x=(w-text_w)/2:y=h-text_h-{margin}",
+    "top": "x=(w-text_w)/2:y={margin}",
+    "center": "x=(w-text_w)/2:y=(h-text_h)/2",
+    "bottom-left": "x={margin}:y=h-text_h-{margin}",
+    "bottom-right": "x=w-text_w-{margin}:y=h-text_h-{margin}",
+    "top-left": "x={margin}:y={margin}",
+    "top-right": "x=w-text_w-{margin}:y={margin}",
+}
+
+DEFAULT_POSITION = "bottom"
+DEFAULT_COLOR = "white"
+# 背景の帯。無地の映像に白文字だけを置くと読めないことがあるので既定で敷く。
+DEFAULT_BOX_COLOR = "black@0.5"
+
+# 日本語が出せるフォントを優先して探す。見つからなければ利用者に指定してもらう。
+FONT_CANDIDATES = (
+    "C:/Windows/Fonts/meiryo.ttc",
+    "C:/Windows/Fonts/YuGothM.ttc",
+    "C:/Windows/Fonts/msgothic.ttc",
+    "/System/Library/Fonts/ヒラギノ角ゴシック W4.ttc",
+    "/System/Library/Fonts/Hiragino Sans GB.ttc",
+    "/usr/share/fonts/truetype/fonts-japanese-gothic.ttf",
+    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
+    "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
+    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+)
+
+FONT_ENV = "VIDEOEDIT_FONT"
+
+NO_FONT_HINT = (
+    "テロップに使うフォントが見つかりません。--font でフォントファイルを指定するか、"
+    f"環境変数 {FONT_ENV} に設定してください。\n"
+    "  Windows 例: --font C:/Windows/Fonts/meiryo.ttc\n"
+    "日本語を含むテロップでは、日本語が入ったフォントを指定してください"
+    "（英字だけのフォントだと豆腐になります）。"
+)
+
+
+def quote(value: object) -> str:
+    """filter の引数値を、ffmpeg が1つの値として読む形に包む。"""
+    text = str(value).replace("\\", "/")
+    text = text.replace("'", r"'\''")
+    text = text.replace(":", r"\:")
+    return f"'{text}'"
+
+
+def find_font(explicit: str | None = None) -> str:
+    """使うフォントを決める。--font > 環境変数 > 心当たりのパス、の順。"""
+    if explicit:
+        if not os.path.isfile(explicit):
+            raise VideoEditError(f"フォントが見つかりません: {explicit}")
+        return explicit
+    from_env = os.environ.get(FONT_ENV)
+    if from_env:
+        if not os.path.isfile(from_env):
+            raise VideoEditError(f"{FONT_ENV} のフォントが見つかりません: {from_env}")
+        return from_env
+    for candidate in FONT_CANDIDATES:
+        if os.path.isfile(candidate):
+            return candidate
+    raise VideoEditError(NO_FONT_HINT)
+
+
+@dataclass(frozen=True)
+class Overlay:
+    """1つのテロップ。時刻はシーンの先頭からの秒数。"""
+
+    text: str
+    start: float = 0.0
+    end: float | None = None
+    position: str = DEFAULT_POSITION
+    size: int | None = None
+    color: str = DEFAULT_COLOR
+    box_color: str | None = DEFAULT_BOX_COLOR
+
+    def __post_init__(self) -> None:
+        if not self.text.strip():
+            raise VideoEditError("テロップの本文が空です")
+        if self.position not in POSITIONS:
+            raise VideoEditError(
+                f"unknown position: {self.position} (available: {', '.join(POSITIONS)})"
+            )
+        if self.start < 0:
+            raise VideoEditError(f"テロップの開始が負です: {self.start}")
+        if self.end is not None and self.end <= self.start:
+            raise VideoEditError(
+                f"テロップの終了 {self.end} が開始 {self.start} より後になっていません"
+            )
+
+
+def font_size_for(height: int | None, explicit: int | None = None) -> int:
+    """出力の高さから文字サイズを決める。1080p でおよそ 54px。"""
+    if explicit is not None:
+        if explicit <= 0:
+            raise VideoEditError(f"文字サイズが 0 以下です: {explicit}")
+        return explicit
+    return max(16, round((height or 1080) * 0.05))
+
+
+def drawtext_filter(
+    overlay: Overlay,
+    *,
+    text_path: str,
+    font_path: str,
+    height: int | None = None,
+) -> str:
+    """テロップ1つぶんの drawtext フィルタを組み立てる（純粋関数）。
+
+    本文は ``text_path`` に書き出してある前提。書き出すのは呼び出し側の仕事。
+    """
+    size = font_size_for(height, overlay.size)
+    margin = max(8, round((height or 1080) * MARGIN_RATIO))
+    parts = [
+        f"fontfile={quote(font_path)}",
+        f"textfile={quote(text_path)}",
+        f"fontsize={size}",
+        f"fontcolor={quote(overlay.color)}",
+        POSITIONS[overlay.position].format(margin=margin),
+    ]
+    if overlay.box_color:
+        parts.append("box=1")
+        parts.append(f"boxcolor={quote(overlay.box_color)}")
+        parts.append(f"boxborderw={max(4, size // 4)}")
+    parts.append(f"enable={quote(enable_expression(overlay))}")
+    return "drawtext=" + ":".join(parts)
+
+
+def enable_expression(overlay: Overlay) -> str:
+    """テロップを出す区間の式。終わりを決めなければ最後まで出したままにする。"""
+    if overlay.end is None:
+        return f"gte(t,{overlay.start:g})"
+    return f"between(t,{overlay.start:g},{overlay.end:g})"
+
+
+def text_filename(index: int) -> str:
+    """本文を書き出すファイル名。連番にして、どのテロップか追えるようにする。"""
+    return f"text_{index:03d}.txt"
