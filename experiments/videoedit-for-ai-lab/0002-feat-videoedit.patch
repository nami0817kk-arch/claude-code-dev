+++ b/src/videoedit/timeline.py
@@ -0,0 +1,393 @@
+"""台本（YAML / JSON）を読み、ビルドの手順に変換する。
+
+**段階ビルド。** 1本の巨大な filter_complex を組むのではなく、シーンごとに
+中間ファイルへ書き出してから連結する。理由は3つ。
+
+- フィルタが壊れたとき、どのシーンが原因か分かる。
+- シーンごとに解像度を揃えてからテロップを重ねられる。
+- 後から差分ビルド（変わったシーンだけ作り直す）を足せる。
+
+ここも「手順を組み立てて返すだけ」で、ファイルを書いたりプロセスを起動したり
+はしない。実行は cli が担当する。
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+from . import clip, presets
+from .core import VideoEditError, parse_time
+from .overlay import Overlay, drawtext_filter, text_filename
+from .presets import Preset
+from .probe import MediaInfo
+
+SCRIPT_KEYS = {"output", "preset", "font", "scenes"}
+SCENE_KEYS = {"source", "trim", "text", "transition"}
+TEXT_KEYS = {"value", "at", "for", "until", "pos", "size", "color", "box"}
+TRANSITION_KEYS = {"type", "duration"}
+
+# Phase 3 以降で扱う予定のキー。黙って無視すると「BGM が乗らない」ことに
+# 気づけないので、はっきり断る。
+NOT_YET = {
+    "audio": "BGM とダッキングは未対応です",
+    "bgm": "BGM とダッキングは未対応です",
+    "subtitle": "字幕の焼き込みは未対応です",
+    "narration": "ナレーションの差し込みは未対応です",
+}
+
+
+@dataclass(frozen=True)
+class Scene:
+    """台本の1シーン。"""
+
+    source: str
+    start: float | None = None
+    end: float | None = None
+    overlays: tuple[Overlay, ...] = ()
+    join: clip.Join | None = None  # 直前のシーンとの継ぎ目
+
+
+@dataclass(frozen=True)
+class Script:
+    """台本ぜんぶ。"""
+
+    output: str
+    preset: Preset
+    scenes: tuple[Scene, ...]
+    font: str | None = None
+
+
+@dataclass(frozen=True)
+class Step:
+    """ビルドの1手順。``text_files`` は実行前に書き出す本文（パス -> 中身）。"""
+
+    description: str
+    command: list[str]
+    text_files: dict[str, str] = field(default_factory=dict)
+
+
+# --- 読み込み -----------------------------------------------------------
+
+
+def load_script(path: str) -> Script:
+    """台本ファイルを読む。``.json`` は標準ライブラリだけで、``.yaml`` は PyYAML で。"""
+    with open(path, encoding="utf-8") as handle:
+        raw = handle.read()
+    extension = os.path.splitext(path)[1].lower()
+    if extension in (".yaml", ".yml"):
+        data = _load_yaml(raw, path)
+    elif extension == ".json":
+        data = _load_json(raw, path)
+    else:
+        raise VideoEditError(f"台本は .yaml / .yml / .json のいずれかにしてください: {path}")
+    return parse_script(data, base_dir=os.path.dirname(os.path.abspath(path)))
+
+
+def _load_yaml(raw: str, path: str) -> dict:
+    try:
+        import yaml
+    except ImportError:
+        raise VideoEditError(
+            "YAML の台本を読むには PyYAML が要ります。"
+            '`pip install PyYAML`（または pip install -e ".[image]"）を実行するか、'
+            "台本を .json で書いてください"
+        ) from None
+    try:
+        return yaml.safe_load(raw) or {}
+    except yaml.YAMLError as exc:
+        raise VideoEditError(f"台本を YAML として読めませんでした: {path}\n{exc}") from None
+
+
+def _load_json(raw: str, path: str) -> dict:
+    try:
+        return json.loads(raw)
+    except json.JSONDecodeError as exc:
+        raise VideoEditError(f"台本を JSON として読めませんでした: {path}\n{exc}") from None
+
+
+def parse_script(data: object, *, base_dir: str = "") -> Script:
+    """読み込んだ辞書を ``Script`` に変換する。おかしい所はその場で指摘する。"""
+    if not isinstance(data, dict):
+        raise VideoEditError("台本の一番外側は辞書（キーと値）にしてください")
+    _reject_unknown(data, SCRIPT_KEYS, "台本")
+
+    output = data.get("output")
+    if not output:
+        raise VideoEditError("台本に output（書き出し先）がありません")
+
+    raw_scenes = data.get("scenes")
+    if not isinstance(raw_scenes, list) or not raw_scenes:
+        raise VideoEditError("台本に scenes（シーンの並び）が1つ以上必要です")
+
+    try:
+        preset = presets.get(str(data.get("preset", presets.DEFAULT_PRESET)))
+    except KeyError as exc:
+        raise VideoEditError(str(exc)) from None
+    if preset.is_copy:
+        raise VideoEditError("台本では copy プリセットを使えません（テロップも連結もできません）")
+
+    scenes = tuple(
+        _parse_scene(scene, index, base_dir=base_dir, is_first=index == 0)
+        for index, scene in enumerate(raw_scenes)
+    )
+    return Script(
+        output=_resolve(str(output), base_dir),
+        preset=preset,
+        scenes=scenes,
+        font=str(data["font"]) if data.get("font") else None,
+    )
+
+
+def _parse_scene(data: object, index: int, *, base_dir: str, is_first: bool) -> Scene:
+    where = f"scenes[{index}]"
+    if not isinstance(data, dict):
+        raise VideoEditError(f"{where} は辞書にしてください")
+    _reject_unknown(data, SCENE_KEYS, where)
+
+    source = data.get("source")
+    if not source:
+        raise VideoEditError(f"{where} に source（素材のパス）がありません")
+
+    start = end = None
+    if "trim" in data:
+        start, end = _parse_trim(data["trim"], where)
+
+    overlays = tuple(
+        _parse_overlay(item, f"{where}.text[{position}]")
+        for position, item in enumerate(_as_list(data.get("text"), f"{where}.text"))
+    )
+
+    join = None
+    if "transition" in data:
+        if is_first:
+            raise VideoEditError(f"{where} は先頭なので transition を付けられません")
+        join = _parse_transition(data["transition"], where)
+
+    return Scene(
+        source=_resolve(str(source), base_dir),
+        start=start,
+        end=end,
+        overlays=overlays,
+        join=join,
+    )
+
+
+def _parse_trim(value: object, where: str) -> tuple[float | None, float | None]:
+    """``trim: [0, 12.5]`` を秒の組に直す。片側は null で省略できる。"""
+    if not isinstance(value, (list, tuple)) or len(value) != 2:
+        raise VideoEditError(f"{where}.trim は [開始, 終了] の2つで書いてください")
+    start, end = (None if item is None else parse_time(item) for item in value)
+    if start is not None and end is not None and end <= start:
+        raise VideoEditError(f"{where}.trim の終了 {end} が開始 {start} より後になっていません")
+    return start, end
+
+
+def _parse_overlay(data: object, where: str) -> Overlay:
+    if isinstance(data, str):  # `text: "ひとこと"` の略記
+        return Overlay(text=data)
+    if not isinstance(data, dict):
+        raise VideoEditError(f"{where} は文字列か辞書にしてください")
+    _reject_unknown(data, TEXT_KEYS, where)
+
+    value = data.get("value")
+    if not value:
+        raise VideoEditError(f"{where} に value（本文）がありません")
+
+    start = parse_time(data["at"]) if "at" in data else 0.0
+    end = None
+    if "until" in data and "for" in data:
+        raise VideoEditError(f"{where} は for と until を同時に書けません")
+    if "until" in data:
+        end = parse_time(data["until"])
+    elif "for" in data:
+        end = start + parse_time(data["for"])
+
+    return Overlay(
+        text=str(value),
+        start=start,
+        end=end,
+        position=str(data.get("pos", "bottom")),
+        size=int(data["size"]) if data.get("size") is not None else None,
+        color=str(data.get("color", "white")),
+        box_color=_parse_box(data.get("box", True)),
+    )
+
+
+def _parse_box(value: object) -> str | None:
+    """``box: false`` で背景の帯を消す。色を書けばその色にする。"""
+    if value is False:
+        return None
+    if value is True or value is None:
+        return "black@0.5"
+    return str(value)
+
+
+def _parse_transition(data: object, where: str) -> clip.Join:
+    if isinstance(data, str):  # `transition: crossfade` の略記
+        clip.transition_name(data)  # 名前の検査
+        return clip.Join(data)
+    if not isinstance(data, dict):
+        raise VideoEditError(f"{where}.transition は文字列か辞書にしてください")
+    _reject_unknown(data, TRANSITION_KEYS, f"{where}.transition")
+    name = data.get("type")
+    if not name:
+        raise VideoEditError(f"{where}.transition に type がありません")
+    clip.transition_name(str(name))  # 名前の検査をここで済ませる
+    duration = float(data.get("duration", clip.DEFAULT_TRANSITION_DURATION))
+    return clip.Join(str(name), duration)
+
+
+def _as_list(value: object, where: str) -> list:
+    if value is None:
+        return []
+    if isinstance(value, list):
+        return value
+    if isinstance(value, (str, dict)):
+        return [value]
+    raise VideoEditError(f"{where} は文字列・辞書・その並びのいずれかにしてください")
+
+
+def _reject_unknown(data: dict, allowed: set[str], where: str) -> None:
+    """知らないキーは黙って無視せず、その場で指摘する。"""
+    for key in data:
+        if key in allowed:
+            continue
+        if key in NOT_YET:
+            raise VideoEditError(f"{where} の {key}: {NOT_YET[key]}（Phase 3 以降で対応予定）")
+        raise VideoEditError(f"{where} に知らないキーがあります: {key}（使えるのは {', '.join(sorted(allowed))}）")
+
+
+def _resolve(path: str, base_dir: str) -> str:
+    """台本に書かれた相対パスは、台本ファイルの場所を基準に解決する。"""
+    if not base_dir or os.path.isabs(path):
+        return path
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+# --- 手順の組み立て -----------------------------------------------------
+
+
+def scene_path(work_dir: str, index: int) -> str:
+    return os.path.join(work_dir, f"scene_{index:03d}.mp4")
+
+
+def scene_steps(
+    script: Script,
+    *,
+    infos: Sequence[MediaInfo],
+    work_dir: str,
+    font: str,
+) -> list[Step]:
+    """シーンを1本ずつ中間ファイルへ書き出す手順（純粋関数）。
+
+    ``infos`` はシーンの素材を ffprobe した結果。テロップの文字サイズを
+    出来上がりの高さから決めるのに使う。
+    """
+    _check_lengths(script, infos)
+    height = _output_height(script.preset, infos)
+    single = len(script.scenes) == 1
+    steps: list[Step] = []
+    text_index = 0
+
+    for index, (scene, info) in enumerate(zip(script.scenes, infos, strict=True)):
+        _check_overlays(scene, info, where=f"scenes[{index}]")
+        filters: list[str] = []
+        text_files: dict[str, str] = {}
+        for overlay in scene.overlays:
+            text_index += 1
+            path = os.path.join(work_dir, text_filename(text_index))
+            text_files[path] = overlay.text
+            filters.append(
+                drawtext_filter(overlay, text_path=path, font_path=font, height=height)
+            )
+
+        destination = script.output if single else scene_path(work_dir, index)
+        steps.append(
+            Step(
+                description=(
+                    f"シーン {index + 1}/{len(script.scenes)}: "
+                    f"{os.path.basename(scene.source)}"
+                ),
+                command=clip.cut_command(
+                    scene.source,
+                    destination,
+                    start=scene.start,
+                    end=scene.end,
+                    preset=script.preset,
+                    filters=filters,
+                ),
+                text_files=text_files,
+            )
+        )
+    return steps
+
+
+def predicted_scene_infos(
+    script: Script, infos: Sequence[MediaInfo], work_dir: str
+) -> list[MediaInfo]:
+    """まだ書き出していない中間ファイルの姿を、素材から予想する。
+
+    ``--dry-run`` で連結のコマンドまで見せるために使う。実行するときは
+    予想ではなく、実際に書き出した中間ファイルを ffprobe すること
+    （エンコーダの丸めで尺が数十ミリ秒ずれ、トランジションの位置が狂うため）。
+    """
+    _check_lengths(script, infos)
+    return [
+        MediaInfo(
+            path=scene_path(work_dir, index),
+            duration=_scene_duration(scene, info),
+            width=script.preset.width or info.width,
+            height=script.preset.height or info.height,
+            fps=info.fps,
+            video_codec="h264",
+            # 素材に音声が無ければ、書き出した中間ファイルにも音声トラックはできない
+            audio_codec="aac" if info.has_audio else None,
+        )
+        for index, (scene, info) in enumerate(zip(script.scenes, infos, strict=True))
+    ]
+
+
+def concat_step(script: Script, rendered: Sequence[MediaInfo]) -> Step:
+    """中間ファイルを1本に繋ぐ手順（純粋関数）。"""
+    joins = [scene.join or clip.Join() for scene in script.scenes[1:]]
+    return Step(
+        description=f"連結: {len(script.scenes)} シーン -> {os.path.basename(script.output)}",
+        command=clip.concat_command(
+            rendered, script.output, preset=script.preset, joins=joins
+        ),
+    )
+
+
+def _check_lengths(script: Script, infos: Sequence[MediaInfo]) -> None:
+    if len(infos) != len(script.scenes):
+        raise VideoEditError(
+            f"素材の情報が足りません: シーン {len(script.scenes)} 個に対して {len(infos)} 件"
+        )
+
+
+def _output_height(preset: Preset, infos: Sequence[MediaInfo]) -> int | None:
+    """テロップの文字サイズを決めるための、出来上がりの高さ。"""
+    if preset.height:
+        return preset.height
+    return next((info.height for info in infos if info.height), None)
+
+
+def _scene_duration(scene: Scene, info: MediaInfo) -> float:
+    """trim を反映したシーンの尺。連結時のオフセット計算に使う。"""
+    start = scene.start or 0.0
+    end = scene.end if scene.end is not None else info.duration
+    return max(0.0, min(end, info.duration) - start)
+
+
+def _check_overlays(scene: Scene, info: MediaInfo, *, where: str) -> None:
+    """シーンの尺からはみ出したテロップを知らせる。出ないまま気づかないのを防ぐ。"""
+    duration = _scene_duration(scene, info)
+    for position, overlay in enumerate(scene.overlays):
+        if overlay.start >= duration:
+            raise VideoEditError(
+                f"{where}.text[{position}] の開始 {overlay.start:g}s が"
+                f"シーンの尺 {duration:.2f}s を超えています。このテロップは表示されません"
+            )
diff --git a/tests/videoedit/test_cli.py b/tests/videoedit/test_cli.py
index 2f5fde8..f6faec6 100644
--- a/tests/videoedit/test_cli.py
+++ b/tests/videoedit/test_cli.py
@@ -2,6 +2,8 @@
 
 from __future__ import annotations
 
+import json
+
