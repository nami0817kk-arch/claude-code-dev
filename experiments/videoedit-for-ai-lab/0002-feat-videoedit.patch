@@ -0,0 +1,274 @@
+"""台本の読み込みと、ビルド手順の組み立てのテスト。ffmpeg は起動しない。"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from videoedit import clip, timeline
+from videoedit.core import VideoEditError
+from videoedit.probe import MediaInfo
+
+FONT = "/f/font.ttf"
+
+
+def media(path="a.mp4", duration=10.0, *, audio=True, size=(1920, 1080)):
+    return MediaInfo(
+        path=path,
+        duration=duration,
+        width=size[0],
+        height=size[1],
+        fps=30.0,
+        video_codec="h264",
+        audio_codec="aac" if audio else None,
+    )
+
+
+def script_data(**overrides):
+    data = {
+        "output": "out.mp4",
+        "preset": "youtube-1080p",
+        "scenes": [{"source": "a.mp4"}, {"source": "b.mp4"}],
+    }
+    data.update(overrides)
+    return data
+
+
+# --- 読み込み -----------------------------------------------------------
+
+
+def test_parse_reads_scenes_in_order():
+    script = timeline.parse_script(script_data())
+    assert [scene.source for scene in script.scenes] == ["a.mp4", "b.mp4"]
+    assert script.preset.name == "youtube-1080p"
+
+
+def test_relative_paths_resolve_against_the_script_file():
+    script = timeline.parse_script(script_data(), base_dir="/proj/ep01")
+    assert script.scenes[0].source == "/proj/ep01/a.mp4"
+    assert script.output == "/proj/ep01/out.mp4"
+
+
+def test_trim_accepts_clock_notation():
+    data = script_data(scenes=[{"source": "a.mp4", "trim": ["00:00:30", "1:10"]}])
+    scene = timeline.parse_script(data).scenes[0]
+    assert (scene.start, scene.end) == (30.0, 70.0)
+
+
+def test_trim_can_leave_one_side_open():
+    data = script_data(scenes=[{"source": "a.mp4", "trim": [5, None]}])
+    scene = timeline.parse_script(data).scenes[0]
+    assert (scene.start, scene.end) == (5.0, None)
+
+
+def test_a_bare_string_is_shorthand_for_a_telop():
+    data = script_data(scenes=[{"source": "a.mp4", "text": "ひとこと"}])
+    overlay = timeline.parse_script(data).scenes[0].overlays[0]
+    assert (overlay.text, overlay.start, overlay.end) == ("ひとこと", 0.0, None)
+
+
+def test_for_is_measured_from_the_telop_start():
+    data = script_data(scenes=[{"source": "a.mp4", "text": [{"value": "x", "at": 3, "for": 4}]}])
+    overlay = timeline.parse_script(data).scenes[0].overlays[0]
+    assert (overlay.start, overlay.end) == (3.0, 7.0)
+
+
+def test_until_is_an_absolute_position():
+    data = script_data(scenes=[{"source": "a.mp4", "text": [{"value": "x", "at": 3, "until": 4}]}])
+    overlay = timeline.parse_script(data).scenes[0].overlays[0]
+    assert overlay.end == 4.0
+
+
+def test_for_and_until_cannot_both_be_given():
+    data = script_data(
+        scenes=[{"source": "a.mp4", "text": [{"value": "x", "for": 1, "until": 4}]}]
+    )
+    with pytest.raises(VideoEditError, match="同時に書けません"):
+        timeline.parse_script(data)
+
+
+def test_box_false_removes_the_background_band():
+    data = script_data(scenes=[{"source": "a.mp4", "text": [{"value": "x", "box": False}]}])
+    assert timeline.parse_script(data).scenes[0].overlays[0].box_color is None
+
+
+def test_a_bare_string_is_shorthand_for_a_transition():
+    data = script_data(scenes=[{"source": "a.mp4"}, {"source": "b.mp4", "transition": "wipeleft"}])
+    assert timeline.parse_script(data).scenes[1].join == clip.Join("wipeleft", 0.5)
+
+
+def test_the_first_scene_cannot_have_a_transition():
+    data = script_data(scenes=[{"source": "a.mp4", "transition": "fade"}, {"source": "b.mp4"}])
+    with pytest.raises(VideoEditError, match="先頭なので"):
+        timeline.parse_script(data)
+
+
+def test_an_unknown_transition_is_caught_while_reading():
+    data = script_data(scenes=[{"source": "a.mp4"}, {"source": "b.mp4", "transition": "swirl"}])
+    with pytest.raises(VideoEditError, match="unknown transition"):
+        timeline.parse_script(data)
+
+
+@pytest.mark.parametrize(
+    ("data", "message"),
+    [
+        ({"scenes": [{"source": "a.mp4"}]}, "output"),
+        ({"output": "o.mp4"}, "scenes"),
+        ({"output": "o.mp4", "scenes": []}, "scenes"),
+    ],
+)
+def test_a_script_missing_something_says_what(data, message):
+    with pytest.raises(VideoEditError, match=message):
+        timeline.parse_script(data)
+
