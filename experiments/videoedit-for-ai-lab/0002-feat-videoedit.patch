+def test_yaml_without_pyyaml_says_how_to_proceed(tmp_path, monkeypatch):
+    """PyYAML は既定で入らない依存。無いときに何をすればよいか伝える。"""
+    import builtins
+
+    real_import = builtins.__import__
+
+    def blocked(name, *args, **kwargs):
+        if name == "yaml":
+            raise ImportError("no yaml")
+        return real_import(name, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "__import__", blocked)
+    path = tmp_path / "s.yaml"
+    path.write_text("output: o.mp4\n", encoding="utf-8")
+    with pytest.raises(VideoEditError, match="PyYAML"):
+        timeline.load_script(str(path))
