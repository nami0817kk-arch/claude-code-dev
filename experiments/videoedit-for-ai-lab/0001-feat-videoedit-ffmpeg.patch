index 0000000..0d28217
--- /dev/null
+++ b/tests/videoedit/test_clip.py
@@ -0,0 +1,195 @@
+"""コマンド組み立てのテスト。ffmpeg は起動しない。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import clip, presets
+from videoedit.core import VideoEditError
+from videoedit.probe import MediaInfo
+
+
+def media(path="a.mp4", duration=10.0, *, audio=True, size=(1920, 1080), fps=30.0):
+    return MediaInfo(
+        path=path,
+        duration=duration,
+        width=size[0] if size else None,
+        height=size[1] if size else None,
+        fps=fps,
+        video_codec="h264",
+        audio_codec="aac" if audio else None,
+        sample_rate=48000 if audio else None,
+    )
+
+
+SOURCE = presets.get("source")
+COPY = presets.get("copy")
+
+
+def value_after(command, flag):
+    return command[command.index(flag) + 1]
+
+
+# --- cut ---------------------------------------------------------------
+
+
+def test_cut_seeks_before_the_input_so_ffmpeg_does_not_decode_the_whole_file():
+    command = clip.cut_command("in.mp4", "out.mp4", start=90, end=100, preset=SOURCE)
+    assert command.index("-ss") < command.index("-i")
+    assert value_after(command, "-t") == "10.000000"
+    assert command[-1] == "out.mp4"
+
+
+def test_cut_accepts_a_duration_instead_of_an_end():
+    command = clip.cut_command("in.mp4", "out.mp4", start=5, duration=3, preset=SOURCE)
+    assert value_after(command, "-t") == "3.000000"
+
+
+def test_cut_without_an_end_runs_to_the_end_of_the_source():
+    command = clip.cut_command("in.mp4", "out.mp4", start=5, preset=SOURCE)
+    assert "-t" not in command
+
+
+def test_cut_rejects_giving_both_an_end_and_a_duration():
+    with pytest.raises(VideoEditError, match="同時に指定できません"):
+        clip.cut_command("in.mp4", "out.mp4", start=1, end=5, duration=2, preset=SOURCE)
+
+
+def test_cut_rejects_an_end_before_the_start():
+    with pytest.raises(VideoEditError, match="より後にしてください"):
+        clip.cut_command("in.mp4", "out.mp4", start=10, end=5, preset=SOURCE)
+
+
+def test_cut_rejects_a_zero_length_range():
+    with pytest.raises(VideoEditError, match="0 以下"):
+        clip.cut_command("in.mp4", "out.mp4", duration=0, preset=SOURCE)
+
+
+def test_cut_with_copy_guards_against_negative_timestamps():
+    command = clip.cut_command("in.mp4", "out.mp4", start=1, end=3, preset=COPY)
+    assert "-avoid_negative_ts" in command
+    # ストリームコピーなのでフィルタは付けない
+    assert "-vf" not in command
+
+
+def test_no_overwrite_makes_ffmpeg_refuse_an_existing_file():
+    command = clip.cut_command("in.mp4", "out.mp4", preset=SOURCE, overwrite=False)
+    assert "-n" in command and "-y" not in command
+
+
+# --- export ------------------------------------------------------------
+
+
+def test_transcode_applies_the_preset_filter():
+    command = clip.transcode_command("in.mp4", "out.mp4", preset=presets.get("youtube-1080p"))
+    assert "scale=1920:1080" in value_after(command, "-vf")
+
+
+def test_transcode_with_copy_has_no_filter():
+    assert "-vf" not in clip.transcode_command("in.mp4", "out.mp4", preset=COPY)
+
+
+# --- concat (ストリームコピー) -----------------------------------------
+
+
+def test_concat_list_file_escapes_single_quotes():
+    listing = clip.concat_list_file(["/tmp/it's here.mp4", "/tmp/b.mp4"])
+    # ffmpeg のリスト形式は、単一引用符の中で ' を書けない。
+    # いったん閉じて \' を置き、また開く（シェルと同じ書き方）。
+    assert listing.splitlines()[0] == r"file '/tmp/it'\''s here.mp4'"
+    assert listing.endswith("\n")
+
+
+def test_concat_copy_command_uses_the_demuxer():
+    command = clip.concat_copy_command("list.txt", "out.mp4")
+    assert value_after(command, "-f") == "concat"
+    # 相対パスを含むリストを受け付けるために必要
+    assert value_after(command, "-safe") == "0"
+
+
+# --- concat (フィルタ) --------------------------------------------------
+
+
+def test_concat_filter_joins_video_and_audio_of_every_clip():
+    graph = clip.concat_filter([media("a.mp4"), media("b.mp4")], preset=SOURCE)
+    assert "[v0][a0][v1][a1]concat=n=2:v=1:a=1[outv][outa]" in graph
+
+
+def test_concat_fills_in_silence_for_a_clip_without_audio():
+    graph = clip.concat_filter(
+        [media("a.mp4"), media("b.mp4", duration=3.0, audio=False)], preset=SOURCE
+    )
+    # 1本でも音声が欠けると concat が本数の食い違いで失敗するため無音を作る
+    assert "anullsrc=r=48000:cl=stereo,atrim=duration=3.000000" in graph
+    assert "[1:a]" not in graph
+
+
+def test_concat_without_a_sized_preset_follows_the_first_clip():
+    clips = [media("a.mp4", size=(1280, 720), fps=25), media("b.mp4", size=(640, 480), fps=30)]
+    graph = clip.concat_filter(clips, preset=SOURCE)
+    assert graph.count("scale=1280:720") == 2
+    assert graph.count("fps=25") == 2
+
+
+def test_concat_with_a_sized_preset_follows_the_preset():
+    clips = [media("a.mp4", size=(1280, 720)), media("b.mp4", size=(640, 480))]
+    graph = clip.concat_filter(clips, preset=presets.get("shorts"))
+    assert graph.count("scale=1080:1920") == 2
+
+
+def test_concat_needs_at_least_two_clips():
+    with pytest.raises(VideoEditError, match="2本以上"):
+        clip.concat_filter([media()], preset=SOURCE)
+
+
+# --- トランジション -----------------------------------------------------
+
+
+def test_xfade_offsets_shrink_by_the_transition_length_each_time():
+    clips = [media("a.mp4", 10.0), media("b.mp4", 6.0), media("c.mp4", 4.0)]
+    graph = clip.concat_filter(clips, preset=SOURCE, transition="crossfade", transition_duration=1)
+    # 1本目は 10s なので 9s から重ね始める。
+    assert "offset=9.000000" in graph
+    # 2本目を繋いだ時点の尺は 10+6-1=15s なので、次は 14s から。
+    assert "offset=14.000000" in graph
+    assert graph.endswith("acrossfade=d=1[outa]")
+
+
+def test_crossfade_maps_to_the_ffmpeg_fade_transition():
+    graph = clip.concat_filter(
+        [media("a.mp4"), media("b.mp4")], preset=SOURCE, transition="crossfade"
+    )
+    assert "xfade=transition=fade:" in graph
+
+
+def test_transition_must_be_shorter_than_the_shortest_clip():
+    clips = [media("a.mp4", 10.0), media("b.mp4", 2.0)]
+    with pytest.raises(VideoEditError, match="最短の素材"):
+        clip.concat_filter(clips, preset=SOURCE, transition="fade", transition_duration=2.0)
+
+
+def test_transition_length_must_be_positive():
+    with pytest.raises(VideoEditError, match="0 以下"):
+        clip.concat_filter(
+            [media("a.mp4"), media("b.mp4")],
+            preset=SOURCE,
+            transition="fade",
+            transition_duration=0,
+        )
+
+
+def test_unknown_transition_lists_the_available_ones():
+    with pytest.raises(VideoEditError, match="crossfade"):
+        clip.transition_name("swirl")
+
+
+def test_concat_command_maps_the_filter_outputs():
+    command = clip.concat_command([media("a.mp4"), media("b.mp4")], "out.mp4", preset=SOURCE)
+    assert command.count("-i") == 2
+    assert value_after(command, "-map") == "[outv]"
+    assert "[outa]" in command
+
+
+def test_concat_command_rejects_the_copy_preset():
+    with pytest.raises(VideoEditError, match="copy プリセット"):
+        clip.concat_command([media("a.mp4"), media("b.mp4")], "out.mp4", preset=COPY)
