index 0000000..52e240c
--- /dev/null
+++ b/src/videoedit/clip.py
@@ -0,0 +1,259 @@
+"""カット・連結・書き出し。ffmpeg の引数を組み立てる純粋関数。
+
+**この層はプロセスを起動しない。** 引数リストを返すだけにしてあるので、
+ffmpeg が入っていない環境でも組み立て結果をテストできる。実行は
+``core.run`` が担当する。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+from . import presets as presets_module
+from .core import VideoEditError
+from .presets import Preset
+from .probe import MediaInfo
+
+# xfade のトランジション名。左が videoedit での呼び名、右が ffmpeg の名前。
+TRANSITIONS = {
+    "crossfade": "fade",
+    "fade": "fade",
+    "fadeblack": "fadeblack",
+    "fadewhite": "fadewhite",
+    "dissolve": "dissolve",
+    "wipeleft": "wipeleft",
+    "wiperight": "wiperight",
+    "slideleft": "slideleft",
+    "slideright": "slideright",
+    "circleopen": "circleopen",
+    "circleclose": "circleclose",
+}
+
+DEFAULT_TRANSITION_DURATION = 0.5
+
+# 連結時に音声を揃える形式。バラバラのままだと concat / acrossfade が失敗する。
+AUDIO_RATE = 48000
+_AFORMAT = f"aformat=sample_fmts=fltp:sample_rates={AUDIO_RATE}:channel_layouts=stereo"
+
+
+def _head(overwrite: bool) -> list[str]:
+    """ffmpeg の共通の前置き。既定は上書き許可、`-y` を外すと ffmpeg が対話待ちになる。"""
+    return ["ffmpeg", "-hide_banner", "-y" if overwrite else "-n"]
+
+
+def transition_name(name: str) -> str:
+    """videoedit での呼び名を ffmpeg の xfade 名に直す。"""
+    try:
+        return TRANSITIONS[name]
+    except KeyError:
+        raise VideoEditError(
+            f"unknown transition: {name} (available: {', '.join(TRANSITIONS)})"
+        ) from None
+
+
+def cut_command(
+    source: str,
+    output: str,
+    *,
+    start: float | None = None,
+    end: float | None = None,
+    duration: float | None = None,
+    preset: Preset,
+    overwrite: bool = True,
+) -> list[str]:
+    """1本の素材から区間を切り出すコマンドを組み立てる。
+
+    ``-ss`` を ``-i`` より前に置いている（高速シーク）。再エンコードする場合は
+    ffmpeg が直前のキーフレームから復号して捨てるのでフレーム単位で正確だが、
+    ``copy`` プリセットではキーフレーム位置に丸められる。
+    """
+    if end is not None and duration is not None:
+        raise VideoEditError("--to と --for は同時に指定できません")
+    if end is not None:
+        if start is not None and end <= start:
+            raise VideoEditError(f"--to ({end}) は --from ({start}) より後にしてください")
+        duration = end - (start or 0.0)
+    if duration is not None and duration <= 0:
+        raise VideoEditError(f"切り出す長さが 0 以下です: {duration}")
+
+    args = _head(overwrite)
+    if start:
+        args += ["-ss", f"{start:.6f}"]
+    args += ["-i", source]
+    if duration is not None:
+        args += ["-t", f"{duration:.6f}"]
+
+    if preset.is_copy:
+        # キーフレームでない位置から切ると先頭のタイムスタンプが負になることがある
+        args += ["-avoid_negative_ts", "make_zero"]
+    else:
+        video_filter = preset.video_filter()
+        if video_filter:
+            args += ["-vf", video_filter]
+    args += preset.output_args()
+    args.append(output)
+    return args
+
+
+def transcode_command(
+    source: str, output: str, *, preset: Preset, overwrite: bool = True
+) -> list[str]:
+    """1本の素材をプリセットの設定で書き出し直すコマンドを組み立てる。"""
+    args = [*_head(overwrite), "-i", source]
+    if not preset.is_copy:
+        video_filter = preset.video_filter()
+        if video_filter:
+            args += ["-vf", video_filter]
+    args += preset.output_args()
+    args.append(output)
+    return args
+
+
+def concat_list_file(sources: Sequence[str]) -> str:
+    """concat デマルチプレクサに渡すリストファイルの中身を作る。
+
+    パスの ``'`` はエスケープが要る。ffmpeg のリスト形式は
+    ``file 'path'`` の中で ``'`` を ``'\\''`` と書く決まりになっている。
+    """
+    lines = []
+    for source in sources:
+        escaped = str(source).replace("'", r"'\''")
+        lines.append(f"file '{escaped}'")
+    return "\n".join(lines) + "\n"
+
+
+def concat_copy_command(list_path: str, output: str, *, overwrite: bool = True) -> list[str]:
+    """再エンコードせずに連結するコマンド（素材の形式が完全に揃っている場合のみ）。"""
+    return [
+        *_head(overwrite),
+        "-f", "concat",
+        "-safe", "0",
+        "-i", list_path,
+        "-c", "copy",
+        output,
+    ]
+
+
+def resolve_target(
+    clips: Sequence[MediaInfo], preset: Preset
+) -> tuple[tuple[int, int] | None, float | None]:
+    """連結後の解像度と fps を決める。
+
+    プリセットが解像度を持つならそれに従う。持たない（``source``）場合は
+    **先頭の素材に合わせる**。3本の 1080p を繋いだら 1080p のまま出したい、
+    という当たり前の期待に合わせるため。
+    """
+    size = preset.size
+    fps = preset.fps
+    if size is None:
+        size = next((clip.size for clip in clips if clip.size), None)
+    if fps is None:
+        fps = next((clip.fps for clip in clips if clip.fps), None)
+    return size, fps
+
+
+def concat_filter(
+    clips: Sequence[MediaInfo],
+    *,
+    preset: Preset,
+    transition: str | None = None,
+    transition_duration: float = DEFAULT_TRANSITION_DURATION,
+) -> str:
+    """連結の filter_complex を組み立てる。出力は ``[outv]`` と ``[outa]``。
+
+    音声を持たない素材には ``anullsrc`` で無音を作って補う。1本でも音声が
+    欠けていると concat フィルタが本数の食い違いで失敗するため。
+    """
+    if len(clips) < 2:
+        raise VideoEditError("連結には素材が2本以上必要です")
+
+    size, fps = resolve_target(clips, preset)
+    normalize = presets_module.normalize_filter(size, fps) or "setsar=1,format=yuv420p"
+
+    steps: list[str] = []
+    for index, clip in enumerate(clips):
+        steps.append(f"[{index}:v]{normalize}[v{index}]")
+        if clip.has_audio:
+            steps.append(f"[{index}:a]{_AFORMAT}[a{index}]")
+        else:
+            steps.append(
+                f"anullsrc=r={AUDIO_RATE}:cl=stereo,atrim=duration={clip.duration:.6f},"
+                f"{_AFORMAT}[a{index}]"
+            )
+
+    if transition is None:
+        inputs = "".join(f"[v{i}][a{i}]" for i in range(len(clips)))
+        steps.append(f"{inputs}concat=n={len(clips)}:v=1:a=1[outv][outa]")
+        return ";".join(steps)
+
+    steps.extend(_xfade_steps(clips, transition, transition_duration))
+    return ";".join(steps)
+
+
+def _xfade_steps(clips: Sequence[MediaInfo], transition: str, duration: float) -> list[str]:
+    """xfade / acrossfade を数珠つなぎにする。
+
+    xfade の ``offset`` は「それまでに出来上がった映像の中で、重なりを始める
+    位置」。1回繋ぐごとに全体の尺が ``duration`` だけ縮むので、累計から
+    その分を引いていく。
+    """
+    if duration <= 0:
+        raise VideoEditError(f"トランジションの長さが 0 以下です: {duration}")
+    shortest = min(clip.duration for clip in clips)
+    if duration >= shortest:
+        raise VideoEditError(
+            f"トランジション {duration}s が最短の素材 {shortest:.2f}s 以上です。"
+            "--duration を短くするか、短い素材を除いてください"
+        )
+
+    name = transition_name(transition)
+    steps: list[str] = []
+    accumulated = clips[0].duration
+    previous_video, previous_audio = "v0", "a0"
+    for index in range(1, len(clips)):
+        offset = accumulated - duration
+        video_label = f"vx{index}" if index < len(clips) - 1 else "outv"
+        audio_label = f"ax{index}" if index < len(clips) - 1 else "outa"
+        steps.append(
+            f"[{previous_video}][v{index}]"
+            f"xfade=transition={name}:duration={duration:g}:offset={offset:.6f}"
+            f"[{video_label}]"
+        )
+        steps.append(f"[{previous_audio}][a{index}]acrossfade=d={duration:g}[{audio_label}]")
+        accumulated += clips[index].duration - duration
+        previous_video, previous_audio = video_label, audio_label
+    return steps
+
+
+def concat_command(
+    clips: Sequence[MediaInfo],
+    output: str,
+    *,
+    preset: Preset,
+    transition: str | None = None,
+    transition_duration: float = DEFAULT_TRANSITION_DURATION,
+    overwrite: bool = True,
+) -> list[str]:
+    """素材を連結するコマンドを組み立てる（再エンコードあり）。"""
+    if preset.is_copy:
+        raise VideoEditError(
+            "copy プリセットではフィルタを使えません。"
+            "素材の形式が完全に同じなら --copy を、違うなら別のプリセットを指定してください"
+        )
+    args = _head(overwrite)
+    for clip in clips:
+        args += ["-i", clip.path]
+    args += [
+        "-filter_complex",
+        concat_filter(
+            clips,
+            preset=preset,
+            transition=transition,
+            transition_duration=transition_duration,
+        ),
+        "-map", "[outv]",
+        "-map", "[outa]",
+    ]
+    args += preset.output_args()
+    args.append(output)
+    return args
diff --git a/src/videoedit/core.py b/src/videoedit/core.py
new file mode 100644
index 0000000..2f28ac5
--- /dev/null
+++ b/src/videoedit/core.py
@@ -0,0 +1,156 @@
+"""ffmpeg / ffprobe の実行層と、時刻表記の変換。
+
+**外部プロセスを起動するのはこのモジュールだけ。** 他のモジュールは
+「引数リストを組み立てて返す純粋関数」に徹する。ffmpeg が入っていない環境
+（CI）でも、組み立てたコマンドを検証できるようにするため。
+
+videoedit は Python の依存パッケージを増やさない。動画処理は外部バイナリの
+ffmpeg に任せ、こちらは引数を組み立てて呼ぶだけにしている。
+"""
+
+from __future__ import annotations
+
+import json
+import shlex
+import shutil
+import subprocess
+from dataclasses import dataclass
+
+FFMPEG = "ffmpeg"
+FFPROBE = "ffprobe"
+
+INSTALL_HINT = """ffmpeg が見つかりません。導入してから再実行してください。
+
+  Windows : winget install Gyan.FFmpeg    (または scoop install ffmpeg)
+  macOS   : brew install ffmpeg
+  Ubuntu  : sudo apt install ffmpeg
+
+導入後 `ffmpeg -version` が通る（PATH が通っている）ことを確認してください。"""
+
+
+class VideoEditError(RuntimeError):
+    """videoedit が返すエラーの基底。CLI はこれを捕まえて終了コードにする。"""
+
+
+class FFmpegNotFound(VideoEditError):
+    """ffmpeg / ffprobe が PATH に無い。"""
+
+
+class FFmpegFailed(VideoEditError):
+    """ffmpeg / ffprobe が非ゼロで終了した。"""
+
+    def __init__(self, command: list[str], returncode: int, stderr: str) -> None:
+        self.command = command
+        self.returncode = returncode
+        self.stderr = stderr
+        super().__init__(
+            f"{command[0]} が終了コード {returncode} で失敗しました。\n"
+            f"  {format_command(command)}\n"
+            f"{_tail(stderr)}"
+        )
+
+
+def _tail(text: str, lines: int = 12) -> str:
+    """ffmpeg の stderr は長いので、原因が出ている末尾だけを見せる。"""
+    kept = [line for line in text.strip().splitlines() if line.strip()]
+    return "\n".join(kept[-lines:])
+
+
+def format_command(args: list[str]) -> str:
+    """コマンドを人が読める1行に整形する（--dry-run の表示用）。"""
+    return " ".join(shlex.quote(arg) for arg in args)
+
+
+def find(name: str) -> str | None:
+    """実行ファイルを PATH から探す。無ければ None。"""
+    return shutil.which(name)
+
+
+def require(name: str = FFMPEG) -> str:
+    """実行ファイルのパスを返す。無ければ導入手順を添えて落とす。"""
+    path = find(name)
+    if path is None:
+        raise FFmpegNotFound(INSTALL_HINT)
+    return path
+
+
+@dataclass(frozen=True)
+class Result:
+    """外部プロセスの実行結果。``skipped`` は --dry-run で実行しなかった場合。"""
+
+    command: list[str]
+    returncode: int
+    stdout: str
+    stderr: str
+    skipped: bool = False
+
+
+def run(args: list[str], *, dry_run: bool = False, check: bool = True) -> Result:
+    """コマンドを実行する。``dry_run`` なら組み立てた内容を返すだけで起動しない。"""
+    if dry_run:
+        return Result(command=list(args), returncode=0, stdout="", stderr="", skipped=True)
+
+    require(args[0])
+    completed = subprocess.run(args, capture_output=True, text=True, encoding="utf-8", errors="replace")
+    result = Result(
+        command=list(args),
+        returncode=completed.returncode,
+        stdout=completed.stdout or "",
+        stderr=completed.stderr or "",
+    )
+    if check and result.returncode != 0:
+        raise FFmpegFailed(result.command, result.returncode, result.stderr)
+    return result
+
+
+def run_json(args: list[str]) -> dict:
+    """ffprobe を実行して JSON を読む。``--dry-run`` の対象ではない（読むだけなので）。"""
+    result = run(args)
+    try:
+        return json.loads(result.stdout)
+    except json.JSONDecodeError as exc:  # pragma: no cover - ffprobe が壊れた出力を返した場合
+        raise VideoEditError(f"ffprobe の出力を JSON として読めませんでした: {exc}") from exc
+
+
+def parse_time(value: str | float | int) -> float:
+    """``00:01:30.5`` / ``1:30`` / ``90.5`` のいずれも秒(float)に変換する。
+
+    ffmpeg 自身も両方の書式を受け付けるが、尺の計算（トランジションの
+    オフセットなど）を Python 側でやるので、数値に正規化しておく必要がある。
+    """
+    if isinstance(value, (int, float)):
+        seconds = float(value)
+    else:
+        text = str(value).strip()
+        if not text:
+            raise ValueError("時刻が空です")
+        sign = 1.0
+        if text.startswith("-"):
+            sign, text = -1.0, text[1:]
+        parts = text.split(":")
+        if len(parts) > 3:
+            raise ValueError(f"時刻として読めません: {value!r}")
+        try:
+            numbers = [float(part) for part in parts]
+        except ValueError as exc:
+            raise ValueError(f"時刻として読めません: {value!r}") from exc
+        seconds = 0.0
+        for number in numbers:
+            seconds = seconds * 60.0 + number
+        seconds *= sign
+    if seconds < 0:
+        raise ValueError(f"時刻が負です: {value!r}")
+    return seconds
+
+
+def format_time(seconds: float) -> str:
+    """秒を ``HH:MM:SS.mmm`` に整形する（ログとファイル名の表示用）。"""
+    if seconds < 0:
+        raise ValueError(f"時刻が負です: {seconds!r}")
+    whole = int(seconds)
+    milliseconds = round((seconds - whole) * 1000)
+    if milliseconds == 1000:  # 四捨五入で繰り上がった場合
+        whole, milliseconds = whole + 1, 0
+    hours, remainder = divmod(whole, 3600)
+    minutes, secs = divmod(remainder, 60)
+    return f"{hours:02d}:{minutes:02d}:{secs:02d}.{milliseconds:03d}"
