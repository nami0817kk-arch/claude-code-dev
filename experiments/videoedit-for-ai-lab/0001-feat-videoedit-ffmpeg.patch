+"""書き出しプリセットのテスト。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import presets
+
+
+def test_every_preset_has_a_description():
+    for name in presets.available():
+        assert presets.get(name).description
+
+
+def test_unknown_preset_lists_the_available_ones():
+    with pytest.raises(KeyError, match="youtube-1080p"):
+        presets.get("4k-hdr")
+
+
+def test_sized_preset_scales_without_stretching():
+    video_filter = presets.get("shorts").video_filter()
+    assert "scale=1080:1920:force_original_aspect_ratio=decrease" in video_filter
+    assert "pad=1080:1920" in video_filter
+    # ピクセル比が揃っていないと連結時に ffmpeg が拒否する
+    assert "setsar=1" in video_filter
+
+
+def test_source_preset_keeps_the_original_size():
+    source = presets.get("source")
+    assert source.size is None
+    assert source.video_filter() is None
+    assert not source.is_copy
+
+
+def test_copy_preset_does_not_re_encode():
+    copy = presets.get("copy")
+    assert copy.is_copy
+    assert copy.output_args() == ["-c", "copy"]
+
+
+def test_normalize_filter_can_set_fps_only():
+    assert presets.normalize_filter(None, 30) == "fps=30,format=yuv420p"
+
+
+def test_normalize_filter_returns_none_when_there_is_nothing_to_do():
+    assert presets.normalize_filter(None, None) is None
