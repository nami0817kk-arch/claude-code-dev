@@ -0,0 +1,98 @@
+"""実行層と時刻変換のテスト。ffmpeg は起動しない。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import core
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("90", 90.0),
+        ("90.5", 90.5),
+        ("1:30", 90.0),
+        ("00:01:30", 90.0),
+        ("00:01:30.250", 90.25),
+        ("1:00:00", 3600.0),
+        (12, 12.0),
+        (12.5, 12.5),
+    ],
+)
+def test_parse_time_accepts_both_notations(text, expected):
+    assert core.parse_time(text) == pytest.approx(expected)
+
+
+@pytest.mark.parametrize("text", ["", "abc", "1:2:3:4", "1:xx", "-5"])
+def test_parse_time_rejects_bad_input(text):
+    with pytest.raises(ValueError):
+        core.parse_time(text)
+
+
+@pytest.mark.parametrize(
+    ("seconds", "expected"),
+    [
+        (0, "00:00:00.000"),
+        (90.25, "00:01:30.250"),
+        (3661.5, "01:01:01.500"),
+        # 四捨五入で 1000ms になる値が 00:00:01.000 に繰り上がること
+        (0.9999, "00:00:01.000"),
+    ],
+)
+def test_format_time(seconds, expected):
+    assert core.format_time(seconds) == expected
+
+
+def test_format_time_rejects_negative():
+    with pytest.raises(ValueError):
+        core.format_time(-1)
+
+
+def test_format_command_quotes_paths_with_spaces():
+    assert core.format_command(["ffmpeg", "-i", "my clip.mp4"]) == "ffmpeg -i 'my clip.mp4'"
+
+
+def test_require_reports_how_to_install(monkeypatch):
+    monkeypatch.setattr(core.shutil, "which", lambda name: None)
+    with pytest.raises(core.FFmpegNotFound) as excinfo:
+        core.require()
+    assert "winget install" in str(excinfo.value)
+
+
+def test_run_with_dry_run_does_not_start_a_process(monkeypatch):
+    def explode(*args, **kwargs):  # pragma: no cover - 呼ばれたら失敗
+        raise AssertionError("--dry-run なのにプロセスを起動した")
+
+    monkeypatch.setattr(core.subprocess, "run", explode)
+    result = core.run(["ffmpeg", "-i", "in.mp4", "out.mp4"], dry_run=True)
+    assert result.skipped
+    assert result.command == ["ffmpeg", "-i", "in.mp4", "out.mp4"]
+
+
+def test_run_raises_with_the_tail_of_stderr(monkeypatch):
+    monkeypatch.setattr(core.shutil, "which", lambda name: f"/usr/bin/{name}")
+
+    class Completed:
+        returncode = 1
+        stdout = ""
+        stderr = "\n".join(f"line {index}" for index in range(30))
+
+    monkeypatch.setattr(core.subprocess, "run", lambda *a, **k: Completed())
+    with pytest.raises(core.FFmpegFailed) as excinfo:
+        core.run(["ffmpeg", "-i", "missing.mp4", "out.mp4"])
+    message = str(excinfo.value)
+    assert "line 29" in message
+    assert "line 0" not in message
+
+
+def test_run_can_return_a_failure_without_raising(monkeypatch):
+    monkeypatch.setattr(core.shutil, "which", lambda name: f"/usr/bin/{name}")
+
+    class Completed:
+        returncode = 3
+        stdout = ""
+        stderr = "boom"
+
+    monkeypatch.setattr(core.subprocess, "run", lambda *a, **k: Completed())
+    assert core.run(["ffmpeg"], check=False).returncode == 3
