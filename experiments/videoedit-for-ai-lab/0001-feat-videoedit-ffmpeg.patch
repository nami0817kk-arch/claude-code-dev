+"""サムネイル切り出しのテスト。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit.core import VideoEditError
+from videoedit.thumbnail import thumbnail_command
+
+
+def test_thumbnail_takes_a_single_frame():
+    command = thumbnail_command("in.mp4", "out.jpg", at=12)
+    assert command[command.index("-frames:v") + 1] == "1"
+    assert command.index("-ss") < command.index("-i")
+    assert command[-1] == "out.jpg"
+
+
+def test_thumbnail_at_zero_does_not_seek():
+    assert "-ss" not in thumbnail_command("in.mp4", "out.jpg")
+
+
+def test_thumbnail_scales_to_an_even_height():
+    command = thumbnail_command("in.mp4", "out.jpg", width=640)
+    # -2 は「比率を保ちつつ偶数に丸める」。奇数だとエンコーダが受け付けない。
+    assert command[command.index("-vf") + 1] == "scale=640:-2"
+
+
+def test_thumbnail_rejects_a_negative_position():
+    with pytest.raises(VideoEditError, match="負です"):
+        thumbnail_command("in.mp4", "out.jpg", at=-1)
+
+
+def test_thumbnail_rejects_a_zero_width():
+    with pytest.raises(VideoEditError, match="0 以下"):
+        thumbnail_command("in.mp4", "out.jpg", width=0)
