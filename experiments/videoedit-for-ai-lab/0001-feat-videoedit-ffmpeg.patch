diff --git a/src/videoedit/cli.py b/src/videoedit/cli.py
new file mode 100644
index 0000000..e7715fc
--- /dev/null
+++ b/src/videoedit/cli.py
@@ -0,0 +1,284 @@
+"""コマンドラインインターフェース。
+
+    python -m videoedit probe in.mp4
+    python -m videoedit cut in.mp4 --from 00:01:30 --to 00:02:10 -o out.mp4
+    python -m videoedit concat a.mp4 b.mp4 -o out.mp4 --transition crossfade
+    python -m videoedit export in.mp4 --preset shorts -o out.mp4
+    python -m videoedit thumb in.mp4 --at 12
+    python -m videoedit presets
+
+すべてのサブコマンドに ``--dry-run`` がある。動画を書き出す前に、組み立てた
+ffmpeg コマンドを人が確認できるようにするため。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import tempfile
+import unicodedata
+from collections.abc import Sequence
+
+from . import clip, presets
+from .core import VideoEditError, format_command, format_time, parse_time, run
+from .probe import MediaInfo, probe
+from .thumbnail import thumbnail_command
+
+
+def _report(path: str, *, dry_run: bool) -> None:
+    """書き出したファイルを1行で報告する。実際に読み直して確かめる。"""
+    if dry_run:
+        return
+    try:
+        info = probe(path)
+    except VideoEditError:
+        print(f"wrote {path}")
+        return
+    print(f"wrote {path} ({info.describe()})")
+
+
+def _execute(args: list[str], *, dry_run: bool, verbose: bool) -> int:
+    if dry_run or verbose:
+        print(format_command(args))
+    run(args, dry_run=dry_run)
+    return 0
+
+
+def _preset_for(name: str) -> presets.Preset:
+    try:
+        return presets.get(name)
+    except KeyError as exc:
+        raise VideoEditError(str(exc)) from None
+
+
+def cmd_probe(args: argparse.Namespace) -> int:
+    info = probe(args.source)
+    if args.json:
+        print(json.dumps(_as_dict(info), ensure_ascii=False, indent=2))
+    else:
+        print(f"{info.path}: {info.describe()}")
+        print(f"  尺 {format_time(info.duration)}")
+    return 0
+
+
+def _as_dict(info: MediaInfo) -> dict:
+    return {
+        "path": info.path,
+        "duration": info.duration,
+        "width": info.width,
+        "height": info.height,
+        "fps": info.fps,
+        "video_codec": info.video_codec,
+        "audio_codec": info.audio_codec,
+        "sample_rate": info.sample_rate,
+    }
+
+
+def cmd_cut(args: argparse.Namespace) -> int:
+    command = clip.cut_command(
+        args.source,
+        args.output,
+        start=parse_time(args.start) if args.start else None,
+        end=parse_time(args.end) if args.end else None,
+        duration=parse_time(args.duration) if args.duration else None,
+        preset=_preset_for("copy" if args.copy else args.preset),
+        overwrite=not args.no_overwrite,
+    )
+    _execute(command, dry_run=args.dry_run, verbose=args.verbose)
+    _report(args.output, dry_run=args.dry_run)
+    return 0
+
+
+def cmd_concat(args: argparse.Namespace) -> int:
+    if len(args.sources) < 2:
+        raise VideoEditError("連結には素材が2本以上必要です")
+
+    if args.copy:
+        if args.transition:
+            raise VideoEditError(
+                "--copy はストリームをそのまま繋ぐので、トランジションは付けられません"
+            )
+        return _concat_copy(args)
+
+    clips = [probe(source) for source in args.sources]
+    command = clip.concat_command(
+        clips,
+        args.output,
+        preset=_preset_for(args.preset),
+        transition=args.transition,
+        transition_duration=args.duration,
+        overwrite=not args.no_overwrite,
+    )
+    _execute(command, dry_run=args.dry_run, verbose=args.verbose)
+    _report(args.output, dry_run=args.dry_run)
+    return 0
+
+
+def _concat_copy(args: argparse.Namespace) -> int:
+    """concat デマルチプレクサで繋ぐ。リストファイルを一時ファイルに書いて渡す。"""
+    listing = clip.concat_list_file([os.path.abspath(source) for source in args.sources])
+    if args.dry_run:
+        print("# 一時ファイルに書き出すリスト:")
+        for line in listing.splitlines():
+            print(f"#   {line}")
+        print(format_command(clip.concat_copy_command("<listfile>", args.output)))
+        return 0
+
+    handle = tempfile.NamedTemporaryFile(
+        "w", suffix=".txt", encoding="utf-8", delete=False, newline="\n"
+    )
+    try:
+        # Windows では開いたままのファイルを消せないので、確実に閉じてから使う
+        with handle:
+            handle.write(listing)
+        command = clip.concat_copy_command(
+            handle.name, args.output, overwrite=not args.no_overwrite
+        )
+        _execute(command, dry_run=False, verbose=args.verbose)
+    finally:
+        os.unlink(handle.name)
+    _report(args.output, dry_run=False)
+    return 0
+
+
+def cmd_export(args: argparse.Namespace) -> int:
+    command = clip.transcode_command(
+        args.source,
+        args.output,
+        preset=_preset_for(args.preset),
+        overwrite=not args.no_overwrite,
+    )
+    _execute(command, dry_run=args.dry_run, verbose=args.verbose)
+    _report(args.output, dry_run=args.dry_run)
+    return 0
+
+
+def cmd_thumb(args: argparse.Namespace) -> int:
+    output = args.output or f"{os.path.splitext(args.source)[0]}_thumb.jpg"
+    command = thumbnail_command(
+        args.source,
+        output,
+        at=parse_time(args.at) if args.at else 0.0,
+        width=args.width,
+        overwrite=not args.no_overwrite,
+    )
+    _execute(command, dry_run=args.dry_run, verbose=args.verbose)
+    if not args.dry_run:
+        print(f"wrote {output}")
+    return 0
+
+
+def _display_width(text: str) -> int:
+    """全角を2桁と数えた表示幅。日本語を含む列を桁揃えするため。"""
+    return sum(2 if unicodedata.east_asian_width(char) in "WF" else 1 for char in text)
+
+
+def _pad(text: str, width: int) -> str:
+    return text + " " * max(0, width - _display_width(text))
+
+
+def cmd_presets(args: argparse.Namespace) -> int:
+    rows = []
+    for name in presets.available():
+        preset = presets.get(name)
+        rows.append((name, f"{preset.width}x{preset.height}" if preset.size else "素材のまま", preset.description))
+    name_width = max(_display_width(row[0]) for row in rows)
+    size_width = max(_display_width(row[1]) for row in rows)
+    for name, size, description in rows:
+        print(f"{_pad(name, name_width)}  {_pad(size, size_width)}  {description}")
+    return 0
+
+
+def _add_common(parser: argparse.ArgumentParser) -> None:
+    parser.add_argument(
+        "--dry-run", action="store_true", help="実行せず、組み立てた ffmpeg コマンドだけ表示する"
+    )
+    parser.add_argument("-v", "--verbose", action="store_true", help="実行するコマンドも表示する")
+    parser.add_argument(
+        "--no-overwrite", action="store_true", help="出力先が既にあるとき上書きせず失敗させる"
+    )
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="videoedit", description="ffmpeg を使った動画編集")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    probe_parser = subparsers.add_parser("probe", help="素材の尺・解像度・fps を表示する")
+    probe_parser.add_argument("source")
+    probe_parser.add_argument("--json", action="store_true", help="JSON で出す")
+    probe_parser.set_defaults(func=cmd_probe)
+
+    cut_parser = subparsers.add_parser("cut", help="区間を切り出す")
+    cut_parser.add_argument("source")
+    cut_parser.add_argument("-o", "--output", required=True)
+    cut_parser.add_argument("--from", dest="start", help="開始位置（00:01:30 または 90）")
+    cut_parser.add_argument("--to", dest="end", help="終了位置")
+    cut_parser.add_argument("--for", dest="duration", help="長さ（--to の代わり）")
+    cut_parser.add_argument(
+        "--preset", default="source", choices=presets.available(), help="書き出しプリセット"
+    )
+    cut_parser.add_argument(
+        "--copy",
+        action="store_true",
+        help="再エンコードせず高速に切る（切れ目が直前のキーフレームにずれ、尺も変わる）",
+    )
+    _add_common(cut_parser)
+    cut_parser.set_defaults(func=cmd_cut)
+
+    concat_parser = subparsers.add_parser("concat", help="複数の素材を繋ぐ")
+    concat_parser.add_argument("sources", nargs="+")
+    concat_parser.add_argument("-o", "--output", required=True)
+    concat_parser.add_argument("--preset", default="source", choices=presets.available())
+    concat_parser.add_argument(
+        "--transition", choices=sorted(clip.TRANSITIONS), help="繋ぎ目に入れる効果"
+    )
+    concat_parser.add_argument(
+        "--duration",
+        type=float,
+        default=clip.DEFAULT_TRANSITION_DURATION,
+        help="トランジションの長さ（秒）",
+    )
+    concat_parser.add_argument(
+        "--copy",
+        action="store_true",
+        help="再エンコードせず繋ぐ（素材の形式が完全に同じ場合のみ）",
+    )
+    _add_common(concat_parser)
+    concat_parser.set_defaults(func=cmd_concat)
+
+    export_parser = subparsers.add_parser("export", help="プリセットで書き出し直す")
+    export_parser.add_argument("source")
+    export_parser.add_argument("-o", "--output", required=True)
+    export_parser.add_argument(
+        "--preset", default=presets.DEFAULT_PRESET, choices=presets.available()
+    )
+    _add_common(export_parser)
+    export_parser.set_defaults(func=cmd_export)
+
+    thumb_parser = subparsers.add_parser("thumb", help="サムネイル用に1フレーム切り出す")
+    thumb_parser.add_argument("source")
+    thumb_parser.add_argument("-o", "--output", help="既定は <素材名>_thumb.jpg")
+    thumb_parser.add_argument("--at", help="切り出す位置（00:00:12 または 12）")
+    thumb_parser.add_argument("--width", type=int, help="幅（縦は比率を保って自動）")
+    _add_common(thumb_parser)
+    thumb_parser.set_defaults(func=cmd_thumb)
+
+    presets_parser = subparsers.add_parser("presets", help="書き出しプリセットの一覧")
+    presets_parser.set_defaults(func=cmd_presets)
+
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    try:
+        return args.func(args)
+    except VideoEditError as exc:
+        print(str(exc), file=sys.stderr)
+        return 1
+    except ValueError as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
