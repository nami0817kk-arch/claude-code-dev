+"""サムネイル用に1フレームを切り出す。"""
+
+from __future__ import annotations
+
+from .core import VideoEditError
+
+# 高画質側の JPEG 品質。ffmpeg の -q:v は 2 が実質最高画質。
+JPEG_QUALITY = "2"
+
+
+def thumbnail_command(
+    source: str,
+    output: str,
+    *,
+    at: float = 0.0,
+    width: int | None = None,
+    overwrite: bool = True,
+) -> list[str]:
+    """``at`` 秒の1フレームを画像として書き出すコマンドを組み立てる。"""
+    if at < 0:
+        raise VideoEditError(f"切り出し位置が負です: {at}")
+
+    args = ["ffmpeg", "-hide_banner", "-y" if overwrite else "-n"]
+    if at:
+        args += ["-ss", f"{at:.6f}"]
+    args += ["-i", source]
+    if width is not None:
+        if width <= 0:
+            raise VideoEditError(f"幅が 0 以下です: {width}")
+        # -2 は「縦は横に合わせて偶数に丸める」。奇数だとエンコーダが受け付けない。
+        args += ["-vf", f"scale={width}:-2"]
+    args += ["-frames:v", "1", "-q:v", JPEG_QUALITY, output]
+    return args
