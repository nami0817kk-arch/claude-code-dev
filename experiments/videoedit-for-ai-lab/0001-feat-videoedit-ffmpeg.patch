+"""ffprobe の出力を読む部分のテスト。ffprobe は起動しない。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import probe
+from videoedit.core import VideoEditError
+
+
+def payload(*, video=True, audio=True, duration="12.5"):
+    streams = []
+    if video:
+        streams.append(
+            {
+                "codec_type": "video",
+                "codec_name": "h264",
+                "width": 1920,
+                "height": 1080,
+                "r_frame_rate": "30000/1001",
+                "avg_frame_rate": "30000/1001",
+            }
+        )
+    if audio:
+        streams.append({"codec_type": "audio", "codec_name": "aac", "sample_rate": "48000"})
+    return {"streams": streams, "format": {"duration": duration}}
+
+
+def test_probe_command_is_read_only():
+    command = probe.probe_command("in.mp4")
+    assert command[0] == "ffprobe"
+    assert command[-1] == "in.mp4"
+    assert "-show_streams" in command
+
+
+def test_parse_probe_reads_every_field():
+    info = probe.parse_probe(payload(), "in.mp4")
+    assert info.duration == pytest.approx(12.5)
+    assert info.size == (1920, 1080)
+    assert info.fps == pytest.approx(29.97, abs=0.01)
+    assert info.has_video and info.has_audio
+    assert info.sample_rate == 48000
+
+
+def test_parse_probe_handles_a_clip_without_audio():
+    info = probe.parse_probe(payload(audio=False), "silent.mp4")
+    assert not info.has_audio
+    assert info.sample_rate is None
+    assert "audio なし" in info.describe()
+
+
+def test_parse_probe_falls_back_to_the_stream_duration():
+    data = payload()
+    data["format"] = {}
+    data["streams"][0]["duration"] = "7.0"
+    assert probe.parse_probe(data, "in.mp4").duration == pytest.approx(7.0)
+
+
+def test_parse_probe_rejects_media_without_a_duration():
+    data = payload(duration="N/A")
+    with pytest.raises(VideoEditError, match="尺を取得できません"):
+        probe.parse_probe(data, "still.png")
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [("30/1", 30.0), ("30000/1001", 29.97), ("25", 25.0), ("0/0", None), (None, None), ("", None)],
+)
+def test_parse_fps(value, expected):
+    result = probe.parse_fps(value)
+    if expected is None:
+        assert result is None
+    else:
+        assert result == pytest.approx(expected, abs=0.01)
+
+
+def test_variable_frame_rate_falls_back_to_avg_frame_rate():
+    data = payload()
+    data["streams"][0]["r_frame_rate"] = "0/0"
+    data["streams"][0]["avg_frame_rate"] = "24/1"
+    assert probe.parse_probe(data, "vfr.mp4").fps == pytest.approx(24.0)
