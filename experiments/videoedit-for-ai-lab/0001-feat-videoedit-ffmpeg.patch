+++ b/tests/videoedit/test_integration.py
@@ -0,0 +1,108 @@
+"""実際に ffmpeg を動かして書き出しを確かめる。
+
+ffmpeg が入っていない環境では丸ごと skip する。組み立てたコマンドの検証は
+他のテストが担当しているので、ここが飛んでも網羅は落ちない。
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import cli, core
+from videoedit.probe import probe
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(core.find("ffmpeg") is None, reason="ffmpeg が無い"),
+    pytest.mark.skipif(core.find("ffprobe") is None, reason="ffprobe が無い"),
+]
+
+
+def make_clip(path, *, seconds, size="320x240", rate=25, audio=True):
+    """lavfi のテストパターンで素材を作る。外部ファイルを持ち込まないため。"""
+    args = [
+        "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
+        "-f", "lavfi", "-i", f"testsrc=size={size}:rate={rate}:duration={seconds}",
+    ]
+    if audio:
+        args += ["-f", "lavfi", "-i", f"sine=frequency=440:duration={seconds}"]
+    args += ["-c:v", "libx264", "-pix_fmt", "yuv420p"]
+    if audio:
+        args += ["-c:a", "aac", "-shortest"]
+    args.append(str(path))
+    core.run(args)
+    return str(path)
+
+
+@pytest.fixture
+def clips(tmp_path):
+    return {
+        "a": make_clip(tmp_path / "a.mp4", seconds=4),
+        "b": make_clip(tmp_path / "b.mp4", seconds=3, size="640x480", rate=30, audio=False),
+        "c": make_clip(tmp_path / "c.mp4", seconds=5),
+    }
+
+
+def test_cut_writes_the_requested_range(tmp_path, clips):
+    out = tmp_path / "cut.mp4"
+    assert cli.main(["cut", clips["a"], "--from", "1", "--to", "3", "-o", str(out)]) == 0
+    assert probe(str(out)).duration == pytest.approx(2.0, abs=0.15)
+
+
+def test_concat_adds_up_the_durations(tmp_path, clips):
+    out = tmp_path / "joined.mp4"
+    argv = ["concat", clips["a"], clips["b"], clips["c"], "-o", str(out)]
+    assert cli.main(argv) == 0
+    info = probe(str(out))
+    assert info.duration == pytest.approx(12.0, abs=0.2)
+    # 音声を持たない素材が混ざっていても、無音で補って1本の音声トラックになる
+    assert info.has_audio
+
+
+def test_concat_with_a_transition_is_shorter_by_the_overlaps(tmp_path, clips):
+    out = tmp_path / "xfade.mp4"
+    argv = [
+        "concat", clips["a"], clips["b"], clips["c"],
+        "-o", str(out), "--transition", "crossfade", "--duration", "0.5",
+    ]
+    assert cli.main(argv) == 0
+    # 12s から、重なり 0.5s x 2回ぶん縮む
+    assert probe(str(out)).duration == pytest.approx(11.0, abs=0.2)
+
+
+def test_concat_normalizes_clips_of_different_sizes(tmp_path, clips):
+    out = tmp_path / "mixed.mp4"
+    argv = ["concat", clips["a"], clips["b"], "-o", str(out), "--preset", "youtube-720p"]
+    assert cli.main(argv) == 0
+    assert probe(str(out)).size == (1280, 720)
+
+
+def test_concat_copy_joins_without_re_encoding(tmp_path, clips):
+    out = tmp_path / "copied.mp4"
+    assert cli.main(["concat", clips["a"], clips["c"], "-o", str(out), "--copy"]) == 0
+    assert probe(str(out)).duration == pytest.approx(9.0, abs=0.2)
+
+
+def test_concat_copy_handles_a_quote_in_the_path(tmp_path, clips):
+    quoted = make_clip(tmp_path / "it's here.mp4", seconds=2)
+    out = tmp_path / "quoted.mp4"
+    assert cli.main(["concat", quoted, clips["a"], "-o", str(out), "--copy"]) == 0
+    assert probe(str(out)).duration == pytest.approx(6.0, abs=0.2)
+
+
+def test_export_to_shorts_is_vertical(tmp_path, clips):
+    out = tmp_path / "shorts.mp4"
+    assert cli.main(["export", clips["a"], "-o", str(out), "--preset", "shorts"]) == 0
+    assert probe(str(out)).size == (1080, 1920)
+
+
+def test_thumb_writes_an_image(tmp_path, clips):
+    out = tmp_path / "thumb.jpg"
+    assert cli.main(["thumb", clips["a"], "--at", "2", "--width", "320", "-o", str(out)]) == 0
+    assert out.stat().st_size > 0
+
+
+def test_a_missing_source_fails_with_ffmpeg_stderr(tmp_path, capsys):
+    out = tmp_path / "out.mp4"
+    assert cli.main(["export", str(tmp_path / "nope.mp4"), "-o", str(out)]) == 1
+    assert "No such file" in capsys.readouterr().err
