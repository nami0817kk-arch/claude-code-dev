+    python -m videoedit cut in.mp4 --from 00:01:30 --to 00:02:10 -o out.mp4
+    python -m videoedit concat a.mp4 b.mp4 -o out.mp4 --transition crossfade
+    python -m videoedit export in.mp4 --preset youtube-1080p -o out.mp4
+    python -m videoedit thumb in.mp4 --at 12 -o thumb.jpg
+
+設計の詳細は docs/videoedit.md。
+
+``probe()`` などの関数はサブモジュールから直接 import する
+（``from videoedit.probe import probe``）。パッケージ直下に同名で再輸出すると
+サブモジュール ``videoedit.probe`` を隠してしまうため。
+"""
+
+from .core import (
+    FFmpegFailed,
+    FFmpegNotFound,
+    VideoEditError,
+    format_time,
+    parse_time,
+)
+from .presets import PRESETS, Preset
+from .probe import MediaInfo
+
+__all__ = [
+    "FFmpegFailed",
+    "FFmpegNotFound",
+    "MediaInfo",
+    "PRESETS",
+    "Preset",
+    "VideoEditError",
+    "format_time",
+    "parse_time",
+]
