+"""CLI のテスト。--dry-run を使うので ffmpeg は起動しない。"""
+
+from __future__ import annotations
+
+import pytest
+
+from videoedit import cli
+from videoedit.core import FFmpegNotFound
+from videoedit.probe import MediaInfo
+
+
+@pytest.fixture
+def fake_probe(monkeypatch):
+    """`concat` が尺を知るために呼ぶ probe を差し替える。"""
+    def probe(path):
+        return MediaInfo(
+            path=path,
+            duration=10.0,
+            width=1920,
+            height=1080,
+            fps=30.0,
+            video_codec="h264",
+            audio_codec="aac",
+            sample_rate=48000,
+        )
+
+    monkeypatch.setattr(cli, "probe", probe)
+    return probe
+
+
+def test_probe_prints_a_summary(monkeypatch, capsys, fake_probe):
+    assert cli.main(["probe", "in.mp4"]) == 0
+    out = capsys.readouterr().out
+    assert "1920x1080" in out
+    assert "00:00:10.000" in out
+
+
+def test_probe_json_is_machine_readable(monkeypatch, capsys, fake_probe):
+    import json
+
+    assert cli.main(["probe", "in.mp4", "--json"]) == 0
+    assert json.loads(capsys.readouterr().out)["duration"] == 10.0
+
+
+def test_cut_dry_run_prints_the_command_without_running_it(capsys):
+    assert cli.main(["cut", "in.mp4", "--from", "1:30", "--to", "1:40", "-o", "o.mp4", "--dry-run"]) == 0
+    out = capsys.readouterr().out
+    assert out.startswith("ffmpeg ")
+    assert "-ss 90.000000" in out
+    # 実行していないので書き出し報告は出ない
+    assert "wrote" not in out
+
+
+def test_cut_copy_uses_stream_copy(capsys):
+    assert cli.main(["cut", "in.mp4", "--from", "1", "-o", "o.mp4", "--copy", "--dry-run"]) == 0
+    assert "-c copy" in capsys.readouterr().out
+
+
+def test_concat_dry_run_builds_a_filter_graph(capsys, fake_probe):
+    argv = ["concat", "a.mp4", "b.mp4", "-o", "o.mp4", "--transition", "crossfade", "--dry-run"]
+    assert cli.main(argv) == 0
+    out = capsys.readouterr().out
+    assert "xfade=transition=fade" in out
+    assert "offset=9.500000" in out
+
+
+def test_concat_copy_dry_run_shows_the_list_file(capsys):
+    assert cli.main(["concat", "a.mp4", "b.mp4", "-o", "o.mp4", "--copy", "--dry-run"]) == 0
+    out = capsys.readouterr().out
+    assert "#   file '" in out
+    assert "-f concat" in out
+
+
+def test_concat_copy_cannot_have_a_transition(capsys):
+    argv = ["concat", "a.mp4", "b.mp4", "-o", "o.mp4", "--copy", "--transition", "fade"]
+    assert cli.main(argv) == 1
+    assert "トランジションは付けられません" in capsys.readouterr().err
+
+
+def test_concat_needs_two_sources(capsys):
+    assert cli.main(["concat", "a.mp4", "-o", "o.mp4", "--dry-run"]) == 1
+    assert "2本以上" in capsys.readouterr().err
+
+
+def test_export_applies_the_preset(capsys):
+    assert cli.main(["export", "in.mp4", "-o", "o.mp4", "--preset", "shorts", "--dry-run"]) == 0
+    assert "scale=1080:1920" in capsys.readouterr().out
+
+
+def test_thumb_derives_a_default_output_name(capsys):
+    assert cli.main(["thumb", "clips/in.mp4", "--at", "12", "--dry-run"]) == 0
+    assert "clips/in_thumb.jpg" in capsys.readouterr().out
+
+
+def test_presets_lists_every_preset(capsys):
+    assert cli.main(["presets"]) == 0
+    out = capsys.readouterr().out
+    assert "youtube-1080p" in out and "shorts" in out
+
+
+def test_a_bad_time_gives_exit_code_two(capsys):
+    assert cli.main(["cut", "in.mp4", "--from", "abc", "-o", "o.mp4", "--dry-run"]) == 2
+    assert "時刻として読めません" in capsys.readouterr().err
+
+
+def test_missing_ffmpeg_explains_how_to_install_it(monkeypatch, capsys):
+    monkeypatch.setattr(cli, "run", _raise_not_found)
+    assert cli.main(["export", "in.mp4", "-o", "o.mp4"]) == 1
+    assert "winget install" in capsys.readouterr().err
+
+
+def _raise_not_found(*args, **kwargs):
+    from videoedit.core import INSTALL_HINT
+
+    raise FFmpegNotFound(INSTALL_HINT)
diff --git a/tests/videoedit/test_clip.py b/tests/videoedit/test_clip.py
