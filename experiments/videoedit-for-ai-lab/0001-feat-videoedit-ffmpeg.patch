index 0000000..522b2a3
--- /dev/null
+++ b/src/videoedit/presets.py
@@ -0,0 +1,138 @@
+"""書き出しプリセット。
+
+エンコード設定を毎回コマンドラインで指定させると、回ごとに画質と互換性が
+ぶれる。用途の名前（youtube-1080p / shorts / preview）で選べるようにして、
+設定そのものはここ1箇所に置く。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+# 縦横比が合わない素材を letterbox する際の色。黒帯。
+PAD_COLOR = "black"
+
+
+@dataclass(frozen=True)
+class Preset:
+    """書き出しの設定ひとまとめ。"""
+
+    name: str
+    description: str
+    width: int | None = None
+    height: int | None = None
+    fps: float | None = None
+    video: tuple[str, ...] = ()
+    audio: tuple[str, ...] = ()
+    container: tuple[str, ...] = ()
+
+    @property
+    def is_copy(self) -> bool:
+        """再エンコードせずストリームコピーするプリセットか。"""
+        return "copy" in self.video
+
+    @property
+    def size(self) -> tuple[int, int] | None:
+        if self.width is None or self.height is None:
+            return None
+        return (self.width, self.height)
+
+    def output_args(self) -> list[str]:
+        """出力側に渡す引数。"""
+        return [*self.video, *self.audio, *self.container]
+
+    def video_filter(self) -> str | None:
+        """このプリセット自身のサイズ・fps に揃えるフィルタ。"""
+        return normalize_filter(self.size, self.fps)
+
+
+def normalize_filter(size: tuple[int, int] | None, fps: float | None) -> str | None:
+    """解像度と fps を揃えるフィルタ文字列を組み立てる。揃える必要が無ければ None。
+
+    `force_original_aspect_ratio=decrease` + `pad` で、縦横比を保ったまま
+    指定サイズに収める（引き伸ばさず黒帯で埋める）。`setsar=1` が無いと
+    ピクセル比の違う素材を連結したときに ffmpeg が拒否する。
+    """
+    steps: list[str] = []
+    if size:
+        width, height = size
+        steps.append(f"scale={width}:{height}:force_original_aspect_ratio=decrease")
+        steps.append(f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2:color={PAD_COLOR}")
+        steps.append("setsar=1")
+    if fps:
+        steps.append(f"fps={fps:g}")
+    if not steps:
+        return None
+    # 連結やトランジションのために画素形式も揃えておく
+    steps.append("format=yuv420p")
+    return ",".join(steps)
+
+
+_H264 = ("-c:v", "libx264", "-pix_fmt", "yuv420p")
+_AAC = ("-c:a", "aac", "-b:a", "192k")
+_FASTSTART = ("-movflags", "+faststart")
+
+PRESETS: dict[str, Preset] = {
+    "source": Preset(
+        name="source",
+        description="素材の解像度・fps のまま H.264 で書き直す（切り貼りの既定）",
+        video=(*_H264, "-crf", "18", "-preset", "medium"),
+        audio=_AAC,
+        container=_FASTSTART,
+    ),
+    "youtube-1080p": Preset(
+        name="youtube-1080p",
+        description="YouTube 標準。1920x1080 / H.264 高画質",
+        width=1920,
+        height=1080,
+        video=(*_H264, "-crf", "18", "-preset", "medium"),
+        audio=_AAC,
+        container=_FASTSTART,
+    ),
+    "youtube-720p": Preset(
+        name="youtube-720p",
+        description="YouTube 軽量。1280x720 / H.264",
+        width=1280,
+        height=720,
+        video=(*_H264, "-crf", "20", "-preset", "medium"),
+        audio=_AAC,
+        container=_FASTSTART,
+    ),
+    "shorts": Preset(
+        name="shorts",
+        description="Shorts / リール向けの縦型。1080x1920",
+        width=1080,
+        height=1920,
+        video=(*_H264, "-crf", "20", "-preset", "medium"),
+        audio=_AAC,
+        container=_FASTSTART,
+    ),
+    "preview": Preset(
+        name="preview",
+        description="内容確認用。640x360 と低画質で最速に書き出す",
+        width=640,
+        height=360,
+        video=(*_H264, "-crf", "32", "-preset", "ultrafast"),
+        audio=("-c:a", "aac", "-b:a", "96k"),
+        container=_FASTSTART,
+    ),
+    "copy": Preset(
+        name="copy",
+        description="再エンコードしない（ストリームコピー）。最速だが素材の形式のまま",
+        video=("-c", "copy"),
+    ),
+}
+
+DEFAULT_PRESET = "youtube-1080p"
+
+
+def get(name: str) -> Preset:
+    """名前でプリセットを引く。無ければ候補を添えて落とす。"""
+    try:
+        return PRESETS[name]
+    except KeyError:
+        raise KeyError(f"unknown preset: {name} (available: {', '.join(available())})") from None
+
+
+def available() -> list[str]:
+    return list(PRESETS)
diff --git a/src/videoedit/probe.py b/src/videoedit/probe.py
new file mode 100644
index 0000000..e42f2ec
--- /dev/null
+++ b/src/videoedit/probe.py
@@ -0,0 +1,132 @@
+"""ffprobe で素材のメタ情報を読む。
+
+尺・解像度・fps が分からないと、連結時の正規化もトランジションの
+オフセット計算もできない。編集の前段として必ずここを通る。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+
+from .core import VideoEditError, run_json
+
+FFPROBE_ARGS = [
+    "-v", "error",
+    "-print_format", "json",
+    "-show_format",
+    "-show_streams",
+]
+
+
+@dataclass(frozen=True)
+class MediaInfo:
+    """素材1つ分のメタ情報。"""
+
+    path: str
+    duration: float
+    width: int | None = None
+    height: int | None = None
+    fps: float | None = None
+    video_codec: str | None = None
+    audio_codec: str | None = None
+    sample_rate: int | None = None
+
+    @property
+    def has_video(self) -> bool:
+        return self.video_codec is not None
+
+    @property
+    def has_audio(self) -> bool:
+        return self.audio_codec is not None
+
+    @property
+    def size(self) -> tuple[int, int] | None:
+        if self.width is None or self.height is None:
+            return None
+        return (self.width, self.height)
+
+    def describe(self) -> str:
+        """`videoedit probe` が出す1行サマリ。"""
+        parts = [f"{self.duration:.2f}s"]
+        if self.size:
+            parts.append(f"{self.width}x{self.height}")
+        if self.fps:
+            parts.append(f"{self.fps:g}fps")
+        parts.append(self.video_codec or "video なし")
+        parts.append(f"{self.audio_codec} {self.sample_rate}Hz" if self.has_audio else "audio なし")
+        return " / ".join(parts)
+
+
+def probe_command(path: str) -> list[str]:
+    """ffprobe に渡す引数を組み立てる（純粋関数）。"""
+    return ["ffprobe", *FFPROBE_ARGS, path]
+
+
+def parse_fps(value: str | None) -> float | None:
+    """``30000/1001`` のような分数表記を float に直す。"""
+    if not value:
+        return None
+    try:
+        fraction = Fraction(value)
+    except (ValueError, ZeroDivisionError):
+        return None
+    if fraction <= 0:
+        return None
+    return float(fraction)
+
+
+def parse_probe(payload: dict, path: str) -> MediaInfo:
+    """ffprobe の JSON を ``MediaInfo`` に変換する（純粋関数）。"""
+    streams = payload.get("streams") or []
+    video = next((s for s in streams if s.get("codec_type") == "video"), None)
+    audio = next((s for s in streams if s.get("codec_type") == "audio"), None)
+
+    duration = _first_duration(payload.get("format") or {}, video, audio)
+    if duration is None:
+        raise VideoEditError(f"尺を取得できませんでした: {path}")
+
+    width = height = fps = None
+    if video is not None:
+        width = _as_int(video.get("width"))
+        height = _as_int(video.get("height"))
+        # avg_frame_rate は可変フレームレートだと 0/0 になることがあるので r_frame_rate を先に見る
+        fps = parse_fps(video.get("r_frame_rate")) or parse_fps(video.get("avg_frame_rate"))
+
+    return MediaInfo(
+        path=path,
+        duration=duration,
+        width=width,
+        height=height,
+        fps=fps,
+        video_codec=(video or {}).get("codec_name"),
+        audio_codec=(audio or {}).get("codec_name"),
+        sample_rate=_as_int((audio or {}).get("sample_rate")),
+    )
+
+
+def _first_duration(*sources: dict | None) -> float | None:
+    """format → video → audio の順に duration を探す。静止画は尺を持たない。"""
+    for source in sources:
+        if not source:
+            continue
+        value = source.get("duration")
+        if value in (None, "", "N/A"):
+            continue
+        try:
+            return float(value)
+        except (TypeError, ValueError):
+            continue
+    return None
+
+
+def _as_int(value: object) -> int | None:
+    try:
+        return int(value)  # type: ignore[arg-type]
+    except (TypeError, ValueError):
+        return None
+
+
+def probe(path: str) -> MediaInfo:
+    """素材を ffprobe で調べる。"""
+    return parse_probe(run_json(probe_command(path)), path)
